      return {
        generic_icon_url: (document.getElementById('custom-icon-url') as HTMLInputElement).value.trim(),
        generic_url: (document.getElementById('custom-url') as HTMLInputElement).value.trim(),
        generic_method: (document.getElementById('custom-method') as HTMLSelectElement).value,
