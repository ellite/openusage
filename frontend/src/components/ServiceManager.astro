        const data = await r.json();

        if (data.user_code) {
          if (urlEl) { urlEl.href = data.verification_uri; }
          if (codeEl) codeEl.textContent = data.user_code;
          if (infoBox) infoBox.style.display = 'block';
          if (statusEl) {
            statusEl.textContent = 'Waiting for GitHub authorization...';
            statusEl.style.color = 'var(--text-muted)';
          }

          copilotPollActive = true;
          let currentIntervalMs = ((data.interval || 5) + 1.5) * 1000; // Safety buffer to avoid slow_down

          async function doPoll() {
            if (!copilotPollActive) return;

            try {
              const pr = await fetch('/api/copilot/device/poll', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ device_code: data.device_code })
              });
              const pdata = await pr.json();

              if (!copilotPollActive) return;

              if (pdata.status === 'ok' && pdata.token) {
                copilotPollActive = false;
                if (startBtn) startBtn.disabled = false;
                (document.getElementById('copilot-token') as HTMLInputElement).value = pdata.token;
                if (statusEl) {
                  statusEl.textContent = '✓ Authorization successful! Token populated below.';
                  statusEl.style.color = 'var(--green)';
                }
                return;
              }

              if (pdata.status === 'expired' || pdata.status === 'denied' || pdata.status === 'error') {
                copilotPollActive = false;
                if (startBtn) startBtn.disabled = false;
                if (statusEl) {
                  statusEl.textContent = `Authorization ${pdata.status}: ${pdata.error || 'Failed'}`;
                  statusEl.style.color = 'var(--red)';
                }
                return;
              }

              // If GitHub requested slow_down backoff, adjust interval
              if (pdata.interval) {
                currentIntervalMs = (pdata.interval + 1.5) * 1000;
              }

              if (copilotPollActive) {
                copilotPollTimeout = setTimeout(doPoll, currentIntervalMs);
              }
            } catch (err) {
              if (copilotPollActive) {
                copilotPollTimeout = setTimeout(doPoll, currentIntervalMs);
              }
            }
          }

          copilotPollTimeout = setTimeout(doPoll, currentIntervalMs);
        } else {
          if (startBtn) startBtn.disabled = false;
        }
      } catch (e) {
        if (startBtn) startBtn.disabled = false;
        alert('Failed to start GitHub device flow');
      }
    });

    // Save Form
    document.getElementById('service-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = (document.getElementById('edit-service-id') as HTMLInputElement).value;
      const type = serviceTypeSelect.value;
      const name = (document.getElementById('service-name') as HTMLInputElement).value.trim();
      const errEl = document.getElementById('modal-error');
      if (errEl) errEl.style.display = 'none';

      let config: Record<string, any> = {};
      if (type === 'claude') {
        config = {
          claude_org_url: (document.getElementById('claude-org-url') as HTMLInputElement).value.trim(),
          claude_cookies: (document.getElementById('claude-cookies') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'gemini') {
        config = {
          gemini_cookies: (document.getElementById('gemini-cookies') as HTMLInputElement).value.trim(),
          gemini_at_token: (document.getElementById('gemini-at-token') as HTMLInputElement).value.trim(),
          gemini_bl: (document.getElementById('gemini-bl') as HTMLInputElement).value.trim(),
          gemini_sid: (document.getElementById('gemini-sid') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'deepseek') {
        config = {
          deepseek_api_key: (document.getElementById('deepseek-key') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'copilot') {
        config = {
          copilot_token: (document.getElementById('copilot-token') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'openai') {
        config = {
          openai_admin_key: (document.getElementById('openai-admin-key') as HTMLInputElement).value.trim(),
          openai_session_key: (document.getElementById('openai-session-key') as HTMLInputElement).value.trim(),
          openai_org_id: (document.getElementById('openai-org-id') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'chatgpt') {
        config = {
          chatgpt_cookies: (document.getElementById('chatgpt-cookies') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'ollama_cloud') {
        config = {
          ollama_cookies: (document.getElementById('ollama_cloud-cookies') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'custom') {
        config = collectCustomConfig();
        if (config.generic_fields.some((field: any) => PROGRESS_FIELD_TYPES.has(field.type) && !field.total_path)) {
          if (errEl) {
            errEl.textContent = 'Choose a total field (Y) for each progress ring or bar.';
            errEl.style.display = 'block';
          }
          return;
        }
      }

      const token = getAuthToken();
      if (!token) return;

      const categoryRaw = (document.getElementById('service-category') as HTMLSelectElement).value;
      const category_id = categoryRaw ? parseInt(categoryRaw) : null;
      const refresh_interval_minutes = Number(
        (document.getElementById('service-refresh-interval') as HTMLInputElement).value
      );
      if (!Number.isInteger(refresh_interval_minutes) || refresh_interval_minutes < 1 || refresh_interval_minutes > 10080) {
        if (errEl) {
          errEl.textContent = 'Refresh interval must be a whole number between 1 and 10,080 minutes.';
          errEl.style.display = 'block';
        }
        return;
      }

      const applicableThresholds = APPLICABLE_THRESHOLDS[type] || [];
      const readThreshold = (kind: string): number | null => {
        if (!applicableThresholds.includes(kind)) return null;
        const raw = (document.getElementById(`notify-${kind}-threshold`) as HTMLInputElement).value.trim();
        return raw ? Number(raw) : null;
      };
      const notify_thresholds = {
        session_threshold: readThreshold('session'),
        weekly_threshold: readThreshold('weekly'),
        monthly_threshold: readThreshold('monthly'),
      };

      const url = editId ? `/api/user-services/${editId}` : '/api/user-services';
      const method = editId ? 'PUT' : 'POST';
      const body = editId
        ? { name, config, category_id, notify_thresholds, refresh_interval_minutes }
        : { service_type: type, name, config, category_id, notify_thresholds, refresh_interval_minutes };

      try {
        const res = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(body)
        });

        if (!res.ok) {
          const d = await res.json();
          throw new Error(d.detail || 'Failed to save service');
        }

        closeModal();
        document.dispatchEvent(new CustomEvent('services-changed'));
      } catch (err: any) {
        if (errEl) {
          errEl.textContent = err.message || 'Failed to save service';
          errEl.style.display = 'block';
        }
      }
    });



    let allCategories: any[] = [];

    async function openServiceManager(serviceId: number | null = null) {
      const token = getAuthToken();
      if (!token) return;

      try {
        const [servicesResponse, categoriesResponse] = await Promise.all([
          fetch('/api/user-services', { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch('/api/categories', { headers: { 'Authorization': `Bearer ${token}` } }),
        ]);

        if (servicesResponse.status === 401 || categoriesResponse.status === 401) {
          localStorage.removeItem('auth_token');
          localStorage.removeItem('auth_user');
          window.location.href = '/login';
          return;
        }
        if (!servicesResponse.ok || !categoriesResponse.ok) {
          throw new Error('Could not load service configuration');
        }

        const services = await servicesResponse.json();
        allCategories = await categoriesResponse.json();

        const categorySelect = document.getElementById('service-category') as HTMLSelectElement;
        if (categorySelect) {
          categorySelect.innerHTML = '<option value="">Uncategorized</option>' +
            allCategories.map(category => `<option value="${category.id}">${escapeHtml(category.name)}</option>`).join('');
        }

        const service = serviceId == null
          ? null
          : services.find((candidate: any) => candidate.id === serviceId);
        if (serviceId != null && !service) throw new Error('Service no longer exists');
        openModal(service);
      } catch (error: any) {
        alert(error.message || 'Could not open service configuration');
      }
    }

    document.addEventListener('open-service-manager', (event: Event) => {
      const serviceId = Number((event as CustomEvent).detail?.id);
      void openServiceManager(Number.isFinite(serviceId) && serviceId > 0 ? serviceId : null);
    });
    document.getElementById('add-service-btn')?.addEventListener('click', () => {
      void openServiceManager();
    });
</script>
