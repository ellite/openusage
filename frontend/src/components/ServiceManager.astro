    function collectCustomConfig(): Record<string, any> {
      const fieldRows = Array.from(document.querySelectorAll('#custom-fields-list .custom-field-row'));
      const fields = fieldRows.map((row: any) => ({
        label: (row.querySelector('.cf-label') as HTMLInputElement).value.trim(),
