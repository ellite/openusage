            if (!rf) return;
            addCustomFieldRow(guessFieldLabel(rf.path), rf.path, guessFieldType(rf.value, rf.path));
          });
        });
      } catch (e: any) {
        resultEl.innerHTML = `<span class="connection-status error" role="status">! ${escapeHtml(e.message || 'Test failed')}</span>`;
      }
    });

