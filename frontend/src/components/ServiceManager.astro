    function getAuthToken() {
      const token = localStorage.getItem('auth_token');
      if (!token) {
        window.location.href = '/login';
        return null;
      }
      return token;
    }

    const modal = document.getElementById('service-modal');
    const serviceTypeSelect = document.getElementById('service-type') as HTMLSelectElement;

    // Which of session/weekly/monthly thresholds apply to each service type.
    // Must be kept in sync with backend/thresholds.py's APPLICABLE_THRESHOLDS.
    const APPLICABLE_THRESHOLDS: Record<string, string[]> = {
      claude: ['session', 'weekly'],
      gemini: ['session', 'weekly'],
      chatgpt: ['session', 'weekly'],
      copilot: ['monthly'],
      ollama_cloud: ['session'],
      deepseek: [],
      openai: [],
      custom: [],
    };

    function updateNotifyThresholdsSection() {
      const type = serviceTypeSelect.value;
      const applicable = APPLICABLE_THRESHOLDS[type] || [];
      const section = document.getElementById('notify-thresholds-section');
      if (section) section.style.display = applicable.length ? 'block' : 'none';
      (['session', 'weekly', 'monthly'] as const).forEach((kind) => {
        const group = document.getElementById(`notify-${kind}-group`);
        if (group) group.style.display = applicable.includes(kind) ? 'block' : 'none';
      });
    }

    // Set when a Custom API preset (e.g. 2Captcha) is applied, so the
    // provider-picker row shows the preset's own icon/name instead of the
    // generic "Custom API" one. Cleared whenever the type changes again.
    let activePresetDisplay: { name: string; icon: string } | null = null;

    function updateProviderPickerDisplay() {
      const type = serviceTypeSelect.value;
      const tmpl = activePresetDisplay || SERVICE_TEMPLATE_MAP[type];
      const iconEl = document.getElementById('provider-picker-icon');
      const imgEl = document.getElementById('provider-picker-img') as HTMLImageElement;
      const nameEl = document.getElementById('provider-picker-name');
      if (iconEl) iconEl.className = `svc-icon ${activePresetDisplay ? 'custom' : type}-bg`;
      if (imgEl) imgEl.src = tmpl?.icon || '/icons/custom.svg';
      if (nameEl) nameEl.textContent = tmpl?.name || type;
      const fromTemplateBtn = document.getElementById('from-template-btn') as HTMLButtonElement;
      if (fromTemplateBtn) fromTemplateBtn.style.display = serviceTypeSelect.disabled ? 'none' : '';
    }

    function updateConfigSection() {
      const type = serviceTypeSelect.value;
      document.querySelectorAll('#service-form .config-section').forEach((el: any) => el.style.display = 'none');
      const target = document.getElementById(`config-${type}`);
      if (target) target.style.display = 'block';
      updateNotifyThresholdsSection();
      updateProviderPickerDisplay();

      const nameInput = document.getElementById('service-name') as HTMLInputElement;
      const editId = (document.getElementById('edit-service-id') as HTMLInputElement).value;
      if (!editId && nameInput) {
        nameInput.value = SERVICE_TEMPLATE_MAP[type]?.defaultName || 'My Service';
      }
    }

    serviceTypeSelect?.addEventListener('change', updateConfigSection);

    const templateModal = document.getElementById('template-modal');

    function applyCustomPreset(preset: CustomApiPreset) {
      if (!serviceTypeSelect) return;
      activePresetDisplay = { name: preset.name, icon: preset.icon };
      serviceTypeSelect.value = 'custom';
      updateConfigSection();

      (document.getElementById('custom-icon-url') as HTMLInputElement).value = preset.icon;
      (document.getElementById('custom-url') as HTMLInputElement).value = preset.url;
      (document.getElementById('custom-method') as HTMLSelectElement).value = preset.method || 'POST';
      (document.getElementById('custom-body') as HTMLTextAreaElement).value = preset.body || '';
      (document.getElementById('custom-headers') as HTMLTextAreaElement).value = preset.headers || '';
      (document.getElementById('service-refresh-interval') as HTMLInputElement).value = String(
        preset.refreshIntervalMinutes || DEFAULT_REFRESH_INTERVAL_MINUTES
      );

      const fieldsList = document.getElementById('custom-fields-list');
      if (fieldsList) fieldsList.innerHTML = '';
      if (preset.fields.length) {
        preset.fields.forEach(f => addCustomFieldRow(f.label, f.path, f.type, f.symbol || '', f.totalPath || ''));
      } else {
        addCustomFieldRow();
      }

      const nameInput = document.getElementById('service-name') as HTMLInputElement;
      const editId = (document.getElementById('edit-service-id') as HTMLInputElement).value;
      if (!editId && nameInput) nameInput.value = preset.name;
    }

    function templateTileHtml(id: string, name: string, iconHtml: string): string {
      return `
        <button type="button" class="template-tile" data-id="${id}" data-search="${escapeHtml(name.toLowerCase())}">
          ${iconHtml}
          <span>${escapeHtml(name)}</span>
        </button>
      `;
    }

    function renderTemplateGrid() {
      const container = document.getElementById('template-categories');
      if (!container) return;

      const providerCategory = `
        <div class="template-category" data-category="providers">
          <div class="template-section-label">Providers</div>
          <div class="template-grid">
            ${SERVICE_TEMPLATES.map(t => templateTileHtml(
              t.id,
              t.name,
              `<span class="svc-icon ${t.id}-bg"><img src="${t.icon}" alt="" width="20" height="20" /></span>`
            )).join('')}
          </div>
        </div>
      `;

      const presetCategories = new Map<string, CustomApiPreset[]>();
      CUSTOM_API_PRESETS.forEach(p => {
        if (!presetCategories.has(p.category)) presetCategories.set(p.category, []);
        presetCategories.get(p.category)!.push(p);
      });
      const presetCategoriesHtml = Array.from(presetCategories.entries()).map(([category, presets]) => `
        <div class="template-category" data-category="${escapeHtml(category.toLowerCase())}">
          <div class="template-section-label">${escapeHtml(category)}</div>
          <div class="template-grid">
            ${presets.map(p => templateTileHtml(
              p.id,
              p.name,
              `<span class="svc-icon custom-bg"><img src="${escapeHtml(p.icon)}" alt="" width="20" height="20" onerror="this.onerror=null;this.src='/icons/custom.svg';" /></span>`
            )).join('')}
          </div>
        </div>
      `).join('');

      container.innerHTML = providerCategory + presetCategoriesHtml;

      const presetIds = new Set(CUSTOM_API_PRESETS.map(p => p.id));
      container.querySelectorAll('.template-tile').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id;
          if (presetIds.has(id)) {
            const preset = CUSTOM_API_PRESETS.find(p => p.id === id);
            if (preset) applyCustomPreset(preset);
          } else if (id && serviceTypeSelect) {
            activePresetDisplay = null;
            serviceTypeSelect.value = id;
            updateConfigSection();
            (document.getElementById('service-refresh-interval') as HTMLInputElement).value = String(
              DEFAULT_REFRESH_INTERVAL_MINUTES
            );
          }
          closeTemplateModal();
        });
      });

      applyTemplateFilter();
    }

    function applyTemplateFilter() {
      const searchInput = document.getElementById('template-search') as HTMLInputElement;
      const query = (searchInput?.value || '').trim().toLowerCase();
      const emptyMsg = document.getElementById('template-empty');
      let anyVisible = false;

      document.querySelectorAll('#template-categories .template-category').forEach((cat: any) => {
        let categoryHasMatch = false;
        cat.querySelectorAll('.template-tile').forEach((tile: any) => {
          const matches = !query
            || tile.dataset.search.includes(query)
            || (cat.dataset.category || '').includes(query);
          tile.style.display = matches ? '' : 'none';
          if (matches) categoryHasMatch = true;
        });
        cat.style.display = categoryHasMatch ? '' : 'none';
        if (categoryHasMatch) anyVisible = true;
      });

      if (emptyMsg) emptyMsg.style.display = anyVisible ? 'none' : 'block';
    }

    document.getElementById('template-search')?.addEventListener('input', applyTemplateFilter);

    function openTemplateModal() {
      const searchInput = document.getElementById('template-search') as HTMLInputElement;
      if (searchInput) searchInput.value = '';
      renderTemplateGrid();
      if (templateModal) (templateModal as HTMLElement).style.display = 'flex';
      searchInput?.focus();
    }

