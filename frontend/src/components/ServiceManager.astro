    document.getElementById('custom-test-btn')?.addEventListener('click', async () => {
      const resultEl = document.getElementById('custom-test-result');
      const token = getAuthToken();
      if (!token || !resultEl) return;
      resultEl.innerHTML = `<span class="msg-hint">Testing...</span>`;
      try {
        const r = await fetch('/api/test-custom', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ config: collectCustomConfig() })
        });
        const res = await r.json();
        if (res.status !== 'ok') {
          resultEl.innerHTML = `<span class="connection-status error" role="status">! ${escapeHtml(res.error || 'Request failed')}</span>`;
          return;
        }

        const fields = res.fields ?? [];
        const responseFields = res.response_fields ?? [];
        customResponseFields = responseFields;
        refreshCustomTotalPathOptions();
        let html = `<p class="connection-status success" role="status">✓ Connection succeeded</p>`;

        if (fields.length) {
          html += `<div class="test-current-fields">` + fields.map((f: any) =>
            `<div class="test-row"><span>${escapeHtml(f.label)}</span><span>${escapeHtml(
              PROGRESS_FIELD_TYPES.has(f.type) ? `${f.value ?? '—'} / ${f.total ?? '—'}` : (f.value ?? '—')
            )}</span></div>`
          ).join('') + `</div>`;
        }

        html += `<p class="msg-hint" style="margin-top:10px;">Click a field below to add it. For a ring or bar, choose the used/remaining variant that matches the API value (X), then select its total field (Y). Mark its renewal or reset timestamp as Reset date.</p>`;
        if (!responseFields.length) {
          html += `<p class="msg-hint">No fields found in the response.</p>`;
        } else {
          html += `<div class="response-fields-box">` + responseFields.map((rf: any, i: number) => `
            <div class="response-field-row">
              <span class="rf-path" title="${escapeHtml(rf.path)}">${escapeHtml(rf.path || '(root)')}</span>
              <span class="rf-value" title="${escapeHtml(rf.value)}">${escapeHtml(rf.value ?? 'null')}</span>
              <button type="button" class="btn btn-sm rf-add-btn" data-idx="${i}">+ Add</button>
            </div>
          `).join('') + `</div>`;
        }

        resultEl.innerHTML = html;
        updateCustomFieldSuggestionButtons();

        resultEl.querySelectorAll('.rf-add-btn').forEach((btn: any) => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.dataset.idx, 10);
