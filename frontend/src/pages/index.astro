---
import Layout from '../layouts/Layout.astro';
import ServiceManager from '../components/ServiceManager.astro';
---

<Layout title="OpenUsage">
  <div class="page-header" id="page-header">
    <div class="page-heading">
      <p class="page-kicker"><span aria-hidden="true"></span> Dashboard</p>
      <div class="header-meta">
        <div class="update-status">
          <span class="update-dot is-loading" aria-hidden="true"></span>
          <p class="subtitle" id="last-updated">Loading...</p>
        </div>
        <span class="service-total"><strong id="service-count">—</strong> connected</span>
      </div>
    </div>
    <div class="header-actions">
      <button id="refresh-btn" class="btn dashboard-action">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5"/></svg>
        <span>Refresh</span>
      </button>
      <button id="add-service-btn" class="btn btn-primary dashboard-action">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Add service</span>
      </button>
    </div>
  </div>

  <div id="dashboard-grid">
    <div class="grid">
      <div class="empty-card loading-card">
        <span class="loading-orbit" aria-hidden="true"></span>
        <p class="subtitle">Loading usage data...</p>
      </div>
    </div>
  </div>

  <!-- Paste-cURL popup: quick fix for a service whose cookies expired -->
  <div id="curl-modal" class="modal-backdrop" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3 id="curl-modal-title">Paste new cURL</h3>
        <button id="curl-modal-close-btn" class="icon-btn-close">&times;</button>
      </div>
      <div class="modal-body">
        <div class="curl-box">
          <label>Import from cURL</label>
          <textarea id="curl-modal-textarea" placeholder="Paste the 'Copy as cURL' request here..."></textarea>
          <button type="button" id="curl-modal-save-btn" class="btn btn-sm">Save &amp; Refresh</button>
          <span id="curl-modal-msg" class="msg-hint"></span>
        </div>
      </div>
    </div>
  </div>

  <ServiceManager />
</Layout>

<style>
  :global(main) {
    max-width: 1180px;
    padding-top: 26px;
  }
  .page-header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 34px;
    padding: 24px 28px;
    overflow: hidden;
    background:
      radial-gradient(circle at 94% 8%, color-mix(in srgb, #25e3a1 16%, transparent), transparent 32%),
      radial-gradient(circle at 70% 110%, color-mix(in srgb, #5575ff 15%, transparent), transparent 42%),
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 95%, #5575ff 5%), var(--surface));
    border: 1px solid color-mix(in srgb, var(--border) 72%, #2bd7ff 28%);
    border-radius: 26px;
    box-shadow: var(--shadow);
  }
  .page-header::after {
    position: absolute;
    right: -54px;
    bottom: -70px;
    width: 270px;
    height: 180px;
    background: linear-gradient(135deg, transparent, color-mix(in srgb, #2bd7ff 8%, transparent));
    border: 1px solid color-mix(in srgb, #2bd7ff 14%, transparent);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }
  .page-heading {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .page-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  .page-kicker span {
    width: 18px;
    height: 3px;
    background: linear-gradient(90deg, #5575ff, #2bd7ff, #49ffa8);
    border-radius: 999px;
  }
  .subtitle {
    margin: 0;
    color: var(--text-muted);
    font-size: 13px;
  }
  .update-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 25px;
    padding: 4px 11px;
    background: color-mix(in srgb, var(--surface-2) 68%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    border-radius: 999px;
  }
  .header-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .service-total {
    color: var(--text-muted);
    font-size: 12px;
  }
  .service-total strong {
    color: var(--text);
    font-size: 13px;
    font-weight: 750;
  }
  .update-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    background: var(--green);
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 14%, transparent);
  }
  .update-dot.is-loading {
    background: var(--gemini);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gemini) 14%, transparent);
    animation: update-pulse 1.4s ease-in-out infinite;
  }
  .update-dot.is-idle {
    background: var(--text-muted);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-muted) 12%, transparent);
  }
  .update-dot.is-error {
    background: var(--red);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 14%, transparent);
  }
  @keyframes update-pulse {
    50% { opacity: 0.35; }
  }
  .header-actions {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 9px;
    flex: 0 0 auto;
  }
  .dashboard-action {
    min-height: 42px;
    gap: 7px;
    padding-right: 18px;
    padding-left: 16px;
    background: color-mix(in srgb, var(--surface-2) 78%, transparent);
    box-shadow: none;
  }
  .dashboard-action.btn-primary {
    color: #031e2b;
    background: linear-gradient(105deg, #2bd7ff, #49ffa8);
    border-color: transparent;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, #2bd7ff 75%, transparent);
  }
  .dashboard-action.btn-primary:hover,
  .dashboard-action.btn-primary:focus-visible {
    color: #031e2b;
    background: linear-gradient(105deg, #5ee1ff, #6bffba);
    border-color: transparent;
  }
  .dashboard-action svg {
    width: 15px;
    height: 15px;
  }

  #dashboard-grid {
    position: relative;
  }

  :global(.welcome-empty-container) {
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, #2bd7ff 12%, transparent), transparent 42%),
      radial-gradient(circle at 85% 80%, color-mix(in srgb, #49ffa8 7%, transparent), transparent 36%),
      var(--surface);
    border: 1px solid color-mix(in srgb, var(--border) 75%, #2bd7ff 25%);
    border-radius: 26px;
    padding: 52px 36px;
    text-align: center;
    box-shadow: var(--shadow);
    max-width: 840px;
    margin: 12px auto 0;
  }
  :global(.welcome-hero-badge) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  :global(.welcome-logo) {
    width: 40px;
    height: 46px;
    filter: drop-shadow(0 8px 18px color-mix(in srgb, #2bd7ff 25%, transparent));
  }
  :global(.provider-pill-stack) {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.provider-pill) {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--surface);
    margin: 0 -4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  :global(.welcome-title) {
    font-size: clamp(25px, 4vw, 32px);
    font-weight: 760;
    letter-spacing: -1px;
    margin: 0 0 10px;
    color: var(--text);
  }
  :global(.welcome-description) {
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto 32px;
  }
  :global(.feature-highlights) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 36px;
    text-align: left;
  }
  :global(.feature-card) {
    background: color-mix(in srgb, var(--surface-2) 82%, transparent);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 20px 18px;
  }
  :global(.feature-icon) {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--gemini);
    margin-bottom: 10px;
  }
  :global(.feature-icon svg) {
    width: 17px;
    height: 17px;
  }
  :global(.feature-card h4) {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 4px;
    color: var(--text);
  }
  :global(.feature-card p) {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }
  :global(.welcome-actions) {
    display: flex;
    justify-content: center;
  }
  :global(.welcome-actions .btn-primary) {
    color: #031e2b;
    background: linear-gradient(105deg, #2bd7ff, #49ffa8);
    border-color: transparent;
    box-shadow: 0 10px 28px -14px color-mix(in srgb, #2bd7ff 78%, transparent);
  }
  :global(.welcome-actions .btn-primary:hover),
  :global(.welcome-actions .btn-primary:focus-visible) {
    color: #031e2b;
    background: linear-gradient(105deg, #5ee1ff, #6bffba);
    border-color: transparent;
  }
  :global(.btn-lg) {
    padding: 12px 28px;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: opacity 0.15s;
  }
  :global(.btn-lg:hover) {
    opacity: 0.9;
  }

  /* Built at runtime via innerHTML when categories are in play (nested
     per-category grids), so it must stay :global() to match those too. */
  :global(.grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 18px;
  }
  :global(.category-section) {
    margin-bottom: 38px;
  }
  :global(.category-section:last-child) {
    margin-bottom: 0;
  }
  :global(.category-heading) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  :global(.category-heading h2) {
    margin: 0;
    color: var(--text);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.25px;
  }
  :global(.category-count) {
    padding: 2px 8px;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface-2) 74%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1.5;
  }
  :global(.category-rule) {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, var(--border), transparent);
  }
  :global(.category-empty-hint) {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: 13px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 22px;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    text-align: center;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  :global(.grid.drag-over-empty .category-empty-hint) {
    border-color: var(--gemini);
    color: var(--text);
    background: color-mix(in srgb, var(--gemini) 7%, var(--surface));
  }
  /* Feedback when dropping into a non-empty grid's empty space (below the
     last card), where there's no hint element for the rule above to style. */
  :global(body.edit-mode .grid.drag-over-empty) {
    outline: 2px dashed var(--gemini);
    outline-offset: 6px;
    border-radius: var(--radius);
  }

  :global(.card) {
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--surface) 96%, white 4%), var(--surface));
    border: 1px solid color-mix(in srgb, var(--border) 88%, var(--text) 12%);
    border-radius: 19px;
    overflow: hidden;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.18), 0 18px 40px -30px rgba(0, 0, 0, 0.75);
    position: relative;
    transition: border-color 0.16s ease, box-shadow 0.16s ease, opacity 0.15s ease;
  }
  :global(.card:hover) {
    border-color: color-mix(in srgb, var(--border) 62%, #2bd7ff 38%);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.18), 0 22px 46px -30px rgba(0, 0, 0, 0.82);
  }
  :global(.card.dragging) {
    opacity: 0.4;
    transform: scale(0.98);
  }
  :global(.card.drag-over) {
    border-color: var(--gemini);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--gemini) 40%, transparent);
  }

  :global(.accent-bar) {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 0;
    width: auto;
    height: 3px;
    border-radius: 0 0 999px 999px;
    background: var(--border);
    z-index: 1;
  }
  :global(.accent-bar.ok)     { background: linear-gradient(90deg, #5575ff, #2bd7ff 50%, #49ffa8); }
  :global(.accent-bar.warn)   { background: linear-gradient(90deg, #5575ff, var(--yellow)); }
  :global(.accent-bar.orange) { background: linear-gradient(90deg, #5575ff, var(--orange)); }
  :global(.accent-bar.error)  { background: linear-gradient(90deg, #5575ff, var(--red)); }
  :global(.accent-bar.none)   { background: var(--border); }

  :global(.card-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 20px 15px;
  }
  :global(.service-info) { display: flex; align-items: center; gap: 11px; min-width: 0; }
  :global(.drag-handle) {
    display: none;
    cursor: grab;
    color: var(--text-muted);
    line-height: 1;
    padding: 2px;
  }
  :global(.drag-handle:active) { cursor: grabbing; }
  :global(.drag-handle svg) { width: 14px; height: 14px; display: block; }
  :global(body.edit-mode .drag-handle) { display: inline-flex; }

  :global(.card-actions) {
    display: none;
    align-items: center;
    gap: 6px;
  }
  :global(body.edit-mode .card-actions) { display: flex; }
  :global(body.edit-mode .card-status) { display: none; }
  :global(.card-action-btn) {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 9px;
    box-shadow: none;
  }
  :global(.card-action-btn svg) { width: 15px; height: 15px; }
  :global(.card-action-btn.card-edit-btn) {
    color: var(--yellow);
    background: color-mix(in srgb, var(--yellow) 12%, var(--surface));
    border-color: color-mix(in srgb, var(--yellow) 38%, transparent);
  }
  :global(.card-action-btn.card-edit-btn:hover),
  :global(.card-action-btn.card-edit-btn:focus-visible) {
    color: var(--yellow);
    background: color-mix(in srgb, var(--yellow) 22%, var(--surface));
    border-color: var(--yellow);
  }
  :global(.card-controls) { display: flex; align-items: center; gap: 8px; }

  :global(.icon) {
    width: 40px;
    height: 40px;
    border: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  :global(.icon img) { width: 20px; height: 20px; object-fit: contain; }
  :global(.icon .icon-light) { display: none; }
  :global(.icon .icon-dark)  { display: block; }
  :global(:root[data-theme="light"] .icon .icon-light) { display: block; }
  :global(:root[data-theme="light"] .icon .icon-dark)  { display: none; }

  :global(.claude-bg)   { background: color-mix(in srgb, var(--claude) 18%, var(--surface)); }
  :global(.gemini-bg)   { background: color-mix(in srgb, var(--gemini) 18%, var(--surface)); }
  :global(.deepseek-bg) { background: color-mix(in srgb, var(--deepseek) 18%, var(--surface)); }
  :global(.copilot-bg)  { background: color-mix(in srgb, var(--copilot) 18%, var(--surface)); }
  :global(.openai-bg)   { background: color-mix(in srgb, var(--openai) 18%, var(--surface)); }
  :global(.chatgpt-bg)  { background: color-mix(in srgb, var(--chatgpt) 18%, var(--surface)); }
  :global(.ollama_cloud-bg) { background: color-mix(in srgb, var(--ollama_cloud) 18%, var(--surface)); }
  :global(.custom-bg)   { background: color-mix(in srgb, var(--custom) 18%, var(--surface)); }

  :global(.service-name) {
    overflow: hidden;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.15px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.badge) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    padding: 5px 9px;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.1px;
  }
  :global(.ok)    { background: color-mix(in srgb, var(--green) 18%, var(--surface)); color: var(--green); }
  :global(.error) { background: color-mix(in srgb, var(--red) 18%, var(--surface)); color: var(--red); }
  :global(.none)  { background: var(--surface-2); color: var(--text-muted); }
  :global(.stale) { background: color-mix(in srgb, var(--yellow) 18%, var(--surface)); color: var(--yellow); }

  :global(.card-body) { padding: 2px 20px 21px; min-height: 110px; }

  /* Hero ring block */
  :global(.hero) {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 8px 0 12px;
    padding: 16px;
    background: color-mix(in srgb, var(--surface-2) 64%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
    border-radius: 15px;
  }
  :global(.ring-wrap) { position: relative; width: 96px; height: 96px; flex-shrink: 0; }
  :global(.ring) { width: 100%; height: 100%; transform: rotate(-90deg); }
  :global(.ring-track) { fill: none; stroke: color-mix(in srgb, var(--border) 68%, transparent); stroke-width: 5; }
  :global(.ring-fill) { fill: none; stroke-width: 5; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease; }
  :global(.ring-fill.bar-low)    { stroke: var(--green); }
  :global(.ring-fill.bar-mid)    { stroke: var(--yellow); }
  :global(.ring-fill.bar-orange) { stroke: var(--orange); }
  :global(.ring-fill.bar-high)   { stroke: var(--red); }
  :global(.ring-center) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  :global(.ring-pct) { font-size: 25px; font-weight: 720; letter-spacing: -0.8px; }
  :global(.ring-pct-sign) { font-size: 15px; font-weight: 600; color: var(--text-muted); }

  :global(.hero-meta) { flex: 1; min-width: 0; }
  :global(.hero-label) { font-size: 13px; font-weight: 650; color: var(--text); margin-bottom: 8px; }
  :global(.hero-resets-cap) { font-size: 11px; font-weight: 600; letter-spacing: 0.6px; text-transform: uppercase; color: var(--text-muted); }
  :global(.hero-resets-val) { font-size: 20px; font-weight: 700; letter-spacing: -0.3px; margin-top: 1px; }
  :global(.hero-resets-date) { font-size: 13px; color: var(--text-muted); margin-top: 2px; }
  :global(.hero-resets-idle) { font-size: 13px; font-weight: 500; color: var(--text-dim); margin-top: 4px; line-height: 1.4; }

  /* Secondary limit rows */
  :global(.lrow) { padding: 10px 0; }
  :global(.lrow-top) { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
  :global(.lrow-label) { font-size: 14px; font-weight: 500; color: var(--text-dim); }
  :global(.lrow-extra) { color: var(--text-muted); font-size: 12.5px; }
  :global(.lrow-extra-below) { color: var(--text-muted); font-size: 12.5px; margin-top: 6px; }
  :global(.lrow-pct) { font-size: 14px; font-weight: 700; }
  :global(.lrow-pct.bar-low)    { color: var(--green); }
  :global(.lrow-pct.bar-mid)    { color: var(--yellow); }
  :global(.lrow-pct.bar-orange) { color: var(--orange); }
  :global(.lrow-pct.bar-high)   { color: var(--red); }
  :global(.lrow-resets) { margin-top: 6px; }
  :global(.lrow-resets-countdown) { font-size: 13px; font-weight: 600; color: var(--text-dim); }
  :global(.lrow-resets-date) { font-size: 12px; color: var(--text-muted); margin-top: 1px; }

  :global(.row) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 6px 0;
  }
  :global(.lbl) { color: var(--text-muted); font-size: 13.5px; }
  :global(.val) { font-weight: 600; font-size: 14px; }
  :global(.val.big) { font-size: 28px; font-weight: 800; letter-spacing: -0.5px; }
  :global(.val.green)  { color: var(--green); }
  :global(.val.yellow) { color: var(--yellow); }
  :global(.val.orange) { color: var(--orange); }
  :global(.val.red)    { color: var(--red); }
  :global(.divider) { border: none; border-top: 1px solid var(--border); margin: 12px 0; }

  :global(.bar-wrap) {
    position: relative;
    width: 100%;
    height: 7px;
    background: color-mix(in srgb, var(--surface-2) 78%, var(--border));
    border-radius: 999px;
  }
  :global(.bar-fill) {
    height: 100%;
    border-radius: 999px;
    transition: width 0.6s ease;
  }
  :global(.bar-tick) {
    position: absolute;
    top: 50%;
    width: 2px;
    height: 16px;
    border-radius: 1px;
    background: var(--text-dim);
    opacity: 0.55;
