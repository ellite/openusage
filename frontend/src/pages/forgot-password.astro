---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Forgot password - OpenUsage">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <img src="/favicon.svg" alt="OpenUsage Logo" width="42" height="42" />
        <h2>Reset your password</h2>
        <p class="auth-subtitle">We'll email you a link to choose a new one.</p>
      </div>

      <form id="forgot-form" class="auth-form">
        <div id="forgot-error" class="auth-error" style="display: none;"></div>
        <div id="forgot-success" class="auth-success" style="display: none;">
          If that email is registered, a reset link has been sent.
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email" />
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary">Send reset link</button>
      </form>

      <p class="back-link"><a href="/login">Back to log in</a></p>
    </div>
  </div>

  <style>
    .auth-container {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(80vh - 100px);
      padding: 20px 0;
    }
    .auth-card {
      width: 100%;
      max-width: 400px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px 28px;
      box-shadow: var(--shadow);
    }
    .auth-header {
      text-align: center;
      margin-bottom: 24px;
    }
    .auth-header img {
      margin-bottom: 12px;
    }
    .auth-header h2 {
      font-size: 22px;
      font-weight: 700;
      margin: 0 0 4px;
    }
    .auth-subtitle {
      font-size: 13.5px;
      color: var(--text-muted);
      margin: 0;
    }
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-dim);
    }
    .form-group input {
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: 14px;
      outline: none;
      width: 100%;
      box-sizing: border-box;
    }
    .form-group input:focus {
      border-color: var(--gemini);
    }
    .btn-primary {
      background: var(--text);
      color: var(--bg);
      border: none;
      padding: 11px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
    }
    .btn-primary:hover {
      opacity: 0.9;
    }
    .auth-error {
      background: color-mix(in srgb, var(--red) 15%, var(--surface));
      border: 1px solid var(--red);
      color: var(--red);
      font-size: 13px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
    }
    .auth-success {
      background: color-mix(in srgb, var(--green) 15%, var(--surface));
      border: 1px solid var(--green);
      color: var(--green);
      font-size: 13px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
    }
    .back-link {
      text-align: center;
      font-size: 13px;
      margin: 16px 0 0;
    }
  </style>

  <script>
    document.getElementById('forgot-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const errorEl = document.getElementById('forgot-error');
      const successEl = document.getElementById('forgot-success');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      if (!emailInput) return;

      if (errorEl) errorEl.style.display = 'none';
      if (successEl) successEl.style.display = 'none';
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not send reset link');
        if (successEl) successEl.style.display = 'block';
        emailInput.value = '';
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'An error occurred';
          errorEl.style.display = 'block';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
