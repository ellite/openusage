---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Choose a new password - OpenUsage">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <img src="/favicon.svg" alt="OpenUsage Logo" width="42" height="42" />
        <h2>Choose a new password</h2>
      </div>

      <div id="invalid-link-msg" class="auth-error" style="display: none;">
        This reset link is invalid or has expired. <a href="/forgot-password">Request a new one</a>.
      </div>

      <form id="reset-form" class="auth-form">
        <div id="reset-error" class="auth-error" style="display: none;"></div>

        <div class="form-group">
          <label for="new-password">New password</label>
          <input type="password" id="new-password" name="new_password" placeholder="Enter a new password" required autocomplete="new-password" />
        </div>

        <div class="form-group">
          <label for="confirm-password">Confirm new password</label>
          <input type="password" id="confirm-password" name="confirm_password" placeholder="Confirm your new password" required autocomplete="new-password" />
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary">Reset password</button>
      </form>

      <div id="success-msg" class="auth-success" style="display: none;">
        Your password has been updated. <a href="/login">Log in</a>.
      </div>
    </div>
  </div>

  <style>
    .auth-container {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(80vh - 100px);
      padding: 20px 0;
    }
    .auth-card {
      width: 100%;
      max-width: 400px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px 28px;
      box-shadow: var(--shadow);
    }
    .auth-header {
      text-align: center;
      margin-bottom: 24px;
    }
    .auth-header img {
      margin-bottom: 12px;
    }
    .auth-header h2 {
      font-size: 22px;
      font-weight: 700;
      margin: 0;
    }
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-dim);
    }
    .form-group input {
      min-height: 48px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      font-size: 16px;
      outline: none;
      width: 100%;
      box-sizing: border-box;
    }
    .form-group input:focus {
      border-color: var(--gemini);
    }
    .btn-primary {
      min-height: 48px;
      background: var(--text);
      color: var(--bg);
      border: none;
      padding: 12px 18px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
    }
    .btn-primary:hover {
      opacity: 0.9;
    }
    .auth-error {
      background: color-mix(in srgb, var(--red) 15%, var(--surface));
      border: 1px solid var(--red);
      color: var(--red);
      font-size: 13px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
    }
    .auth-success {
      background: color-mix(in srgb, var(--green) 15%, var(--surface));
      border: 1px solid var(--green);
      color: var(--green);
      font-size: 13px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
    }
  </style>

  <script>
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');

    if (!token) {
      document.getElementById('reset-form')?.style.setProperty('display', 'none');
      document.getElementById('invalid-link-msg')?.style.setProperty('display', 'block');
    }

    document.getElementById('reset-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
      const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
      const errorEl = document.getElementById('reset-error');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      if (!newPasswordInput || !confirmPasswordInput || !token) return;

      if (errorEl) errorEl.style.display = 'none';

      if (newPasswordInput.value !== confirmPasswordInput.value) {
        if (errorEl) {
          errorEl.textContent = 'Passwords do not match';
          errorEl.style.display = 'block';
        }
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, new_password: newPasswordInput.value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not reset password');

        document.getElementById('reset-form')?.style.setProperty('display', 'none');
        document.getElementById('success-msg')?.style.setProperty('display', 'block');
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'An error occurred';
          errorEl.style.display = 'block';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
