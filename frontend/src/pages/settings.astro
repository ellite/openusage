---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Settings - OpenUsage">
  <div class="settings-header">
    <div>
      <h1>Account</h1>
      <p class="subtitle">Your email is used for password resets and OIDC sign-in</p>
    </div>
  </div>

  <form id="account-form" class="form-row">
    <div class="form-group">
      <input type="email" id="account-email" placeholder="you@example.com" />
    </div>
    <button type="submit" class="btn btn-sm">Save</button>
  </form>
  <div id="account-error" class="auth-error" style="display: none;"></div>
  <div id="account-success" class="auth-success" style="display: none;">Email updated.</div>

  <form id="password-form">
    <div class="form-group">
      <label for="current-password">Current password</label>
      <input type="password" id="current-password" autocomplete="current-password" required />
    </div>
    <div class="form-group">
      <label for="new-password">New password</label>
      <input type="password" id="new-password" autocomplete="new-password" required minlength="4" />
    </div>
    <button type="submit" class="btn btn-sm">Change password</button>
  </form>
  <div id="password-error" class="auth-error" style="display: none;"></div>
  <div id="password-success" class="auth-success" style="display: none;">Password updated.</div>

  <hr class="section-divider" />

  <div class="settings-header">
    <div>
      <h1>Security</h1>
      <p class="subtitle">Two-factor authentication</p>
    </div>
  </div>

  <div id="twofactor-loading" class="msg-hint">Loading…</div>
  <div id="twofactor-disabled-block" style="display: none;">
    <p class="msg-hint">Two-factor authentication is not enabled.</p>
    <div class="twofactor-actions">
      <button type="button" id="twofactor-enable-btn" class="btn btn-sm">Enable two-factor authentication</button>
    </div>
  </div>
  <div id="twofactor-enabled-block" style="display: none;">
    <p class="msg-hint" id="twofactor-recovery-remaining"></p>
    <div class="twofactor-actions">
      <button type="button" id="twofactor-regen-btn" class="btn btn-sm">Regenerate recovery codes</button>
      <button type="button" id="twofactor-disable-btn" class="btn btn-sm btn-danger">Disable</button>
    </div>
  </div>

  <hr class="section-divider" />

  <div class="settings-header">
    <div>
      <h1>Categories</h1>
      <p class="subtitle">Group services into sections on the home page</p>
    </div>
  </div>

  <div id="categories-list" class="categories-list"></div>

  <form id="add-category-form" class="add-category-form">
    <input type="text" id="new-category-name" placeholder="New category name (e.g. Work, Personal)" required />
    <button type="submit" class="btn btn-sm">+ Add Category</button>
  </form>

  <hr class="section-divider" />

  <div class="settings-header">
    <div>
      <h1>Push Notifications</h1>
      <p class="subtitle" id="push-description">Get notified on this device when a service crosses a usage threshold you set below</p>
    </div>
  </div>

  <div id="push-status" class="auth-success" style="display: none;"></div>
  <div class="twofactor-actions">
    <button type="button" id="push-toggle-btn" class="btn btn-sm" hidden>Enable on this device</button>
    <button type="button" id="push-test-btn" class="btn btn-sm" hidden>Send test notification</button>
  </div>

  <hr class="section-divider" />

  <div class="settings-header" id="settings-header">
    <div>
      <h1>Configured Services</h1>
      <p class="subtitle">Manage your connected AI provider instances</p>
    </div>
    <button id="add-service-btn" class="btn btn-primary">+ Add Service</button>
  </div>

  <div id="services-list" class="services-list">
    <div id="loading-state" class="empty-card">
      <p class="subtitle">Loading configured services...</p>
    </div>
  </div>

  <!-- Add/Edit Service Modal -->
  <div id="service-modal" class="modal-backdrop" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modal-title">Add Service</h3>
        <button id="modal-close-btn" class="icon-btn-close">&times;</button>
      </div>
      <div class="modal-body">
        <form id="service-form">
          <input type="hidden" id="edit-service-id" value="" />

          <div class="form-group">
            <label>Service Provider</label>
            <div class="provider-picker">
              <span class="svc-icon custom-bg" id="provider-picker-icon">
                <img id="provider-picker-img" src="/icons/custom.svg" alt="" width="20" height="20" />
              </span>
              <span id="provider-picker-name" class="provider-picker-name">Custom API</span>
              <button type="button" id="from-template-btn" class="btn btn-sm">From template</button>
            </div>
            <select id="service-type" class="form-select" style="display: none;">
              <option value="custom">Custom API</option>
              <option value="claude">Claude (Anthropic)</option>
              <option value="gemini">Google Gemini</option>
              <option value="deepseek">DeepSeek</option>
              <option value="copilot">GitHub Copilot</option>
              <option value="openai">OpenAI</option>
              <option value="chatgpt">ChatGPT</option>
              <option value="ollama_cloud">Ollama Cloud</option>
            </select>
          </div>

          <div class="form-group">
            <label for="service-name">Instance Name</label>
            <input type="text" id="service-name" placeholder="e.g. Personal Claude, Work Gemini" required />
          </div>

          <div class="form-group">
            <label for="service-category">Category</label>
            <select id="service-category" class="form-select">
              <option value="">Uncategorized</option>
            </select>
          </div>

          <hr class="modal-divider" />

          <!-- Config Form: Claude -->
          <div id="config-claude" class="config-section">
            <div class="curl-box">
              <label>Import from cURL</label>
              <textarea id="claude-curl" placeholder="Paste cURL request from claude.ai/api/organizations/..."></textarea>
              <button type="button" id="claude-parse-btn" class="btn btn-sm">Parse cURL</button>
              <span id="claude-curl-msg" class="msg-hint"></span>
            </div>
            <div class="form-group">
              <label for="claude-org-url">Organization URL</label>
              <input type="text" id="claude-org-url" placeholder="https://claude.ai/api/organizations/.../usage" />
            </div>
            <div class="form-group">
              <label for="claude-cookies">Cookies String</label>
              <input type="text" id="claude-cookies" placeholder="sessionKey=sk-ant-..." />
            </div>
          </div>

          <!-- Config Form: Gemini -->
          <div id="config-gemini" class="config-section" style="display: none;">
            <p class="msg-hint">For sessions that keep expiring, sign in to Gemini in Firefox and import its cURL. Brave, Chrome, and Edge can bind Google sessions to the original device, preventing OpenUsage from renewing copied cookies.</p>
            <div class="curl-box">
              <label>Import from cURL</label>
              <textarea id="gemini-curl" placeholder="Paste cURL request from gemini.google.com..."></textarea>
              <button type="button" id="gemini-parse-btn" class="btn btn-sm">Parse cURL</button>
              <span id="gemini-curl-msg" class="msg-hint"></span>
            </div>
            <div class="form-group">
              <label for="gemini-cookies">Cookies String</label>
              <input type="text" id="gemini-cookies" placeholder="__Secure-1PSID=...; __Secure-1PSIDTS=..." />
              <input type="hidden" id="gemini-at-token" />
              <input type="hidden" id="gemini-bl" />
              <input type="hidden" id="gemini-sid" />
            </div>
          </div>

          <!-- Config Form: DeepSeek -->
          <div id="config-deepseek" class="config-section" style="display: none;">
            <div class="form-group">
              <label for="deepseek-key">API Key</label>
              <input type="password" id="deepseek-key" placeholder="sk-..." />
            </div>
          </div>

          <!-- Config Form: Copilot -->
          <div id="config-copilot" class="config-section" style="display: none;">
            <div class="device-flow-box">
              <button type="button" id="copilot-start-btn" class="btn btn-sm">Start GitHub Device Login</button>
              <div id="copilot-device-info" style="display: none;" class="device-info">
                <p>1. Open <a id="copilot-url" href="#" target="_blank" rel="noopener">GitHub Device Auth</a></p>
                <p>2. Enter Code: <strong id="copilot-code" class="code-badge"></strong></p>
                <p class="msg-hint" id="copilot-poll-status">Waiting for authorization...</p>
              </div>
            </div>
            <div class="form-group">
              <label for="copilot-token">GitHub Token / Session Token</label>
              <input type="text" id="copilot-token" placeholder="ghu_..." />
            </div>
          </div>

          <!-- Config Form: OpenAI -->
          <div id="config-openai" class="config-section" style="display: none;">
            <div class="form-group">
              <label for="openai-admin-key">Admin API Key</label>
              <input type="password" id="openai-admin-key" placeholder="sk-admin-..." />
            </div>
            <div class="curl-box">
              <label>Or Import Session from cURL (platform.openai.com)</label>
              <textarea id="openai-curl" placeholder="Paste cURL request from platform.openai.com..."></textarea>
              <button type="button" id="openai-parse-btn" class="btn btn-sm">Parse cURL</button>
              <span id="openai-curl-msg" class="msg-hint"></span>
            </div>
            <div class="form-group">
              <label for="openai-session-key">Session Key (Optional)</label>
              <input type="password" id="openai-session-key" placeholder="sess-..." />
            </div>
            <div class="form-group">
              <label for="openai-org-id">Organization ID (Optional)</label>
              <input type="text" id="openai-org-id" placeholder="org-..." />
            </div>
          </div>

          <!-- Config Form: ChatGPT -->
          <div id="config-chatgpt" class="config-section" style="display: none;">
            <div class="curl-box">
              <label>Import from cURL</label>
              <textarea id="chatgpt-curl" placeholder="Paste cURL request from chatgpt.com..."></textarea>
              <button type="button" id="chatgpt-parse-btn" class="btn btn-sm">Parse cURL</button>
              <span id="chatgpt-curl-msg" class="msg-hint"></span>
            </div>
            <div class="form-group">
              <label for="chatgpt-cookies">Cookies String</label>
              <input type="text" id="chatgpt-cookies" placeholder="__Secure-next-auth.session-token=...; cf_clearance=...; _puid=..." />
              <p class="msg-hint">Include the Cloudflare clearance cookie (cf_clearance) from the same request — it expires in a few hours, so re-paste when fetches start failing even though you're still logged in.</p>
            </div>
          </div>

          <!-- Config Form: Ollama Cloud -->
          <div id="config-ollama_cloud" class="config-section" style="display: none;">
            <div class="curl-box">
              <label>Import from cURL</label>
              <textarea id="ollama_cloud-curl" placeholder="Paste cURL request from ollama.com/settings..."></textarea>
              <button type="button" id="ollama_cloud-parse-btn" class="btn btn-sm">Parse cURL</button>
              <span id="ollama_cloud-curl-msg" class="msg-hint"></span>
            </div>
            <div class="form-group">
              <label for="ollama_cloud-cookies">Cookies String</label>
              <input type="text" id="ollama_cloud-cookies" placeholder="cf_clearance=...; __Secure-session=..." />
              <p class="msg-hint">Scraped from the HTML settings page — the Cloudflare clearance cookie expires in hours, so re-paste when it goes stale.</p>
            </div>
          </div>

          <!-- Config Form: Custom API -->
          <div id="config-custom" class="config-section" style="display: none;">
            <div class="form-group">
              <label for="custom-icon-url">Icon URL (optional)</label>
              <input type="text" id="custom-icon-url" placeholder="https://example.com/favicon.png" />
            </div>
            <div class="form-row">
              <div class="form-group" style="flex: 2;">
                <label for="custom-url">Endpoint URL</label>
                <input type="text" id="custom-url" placeholder="https://api.example.com/getBalance" />
              </div>
              <div class="form-group" style="flex: 1;">
                <label for="custom-method">Method</label>
                <select id="custom-method" class="form-select">
                  <option value="POST">POST</option>
                  <option value="GET">GET</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label for="custom-api-key">API Key</label>
              <div class="password-input-wrap">
                <input type="password" id="custom-api-key" placeholder="Your API key" />
                <button type="button" id="custom-api-key-toggle-btn" class="toggle-pw-btn" aria-label="Toggle API key visibility" title="Show API key">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.77 21.77 0 0 1 5.06-6.06M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.77 21.77 0 0 1-3.22 4.44M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
              </div>
            </div>
            <div class="form-group">
              <label for="custom-body">Request Body (JSON, POST only) — use <code>{`{{api_key}}`}</code> where the key goes</label>
              <textarea id="custom-body" placeholder={`{"clientKey": "{{api_key}}"}`}></textarea>
            </div>
            <div class="form-group">
              <label for="custom-headers">Extra Headers (JSON, optional) — <code>{`{{api_key}}`}</code> supported</label>
              <textarea id="custom-headers" placeholder={`{"Authorization": "Bearer {{api_key}}"}`}></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="custom-success-path">Success check field (optional)</label>
                <input type="text" id="custom-success-path" placeholder="e.g. errorId" />
              </div>
              <div class="form-group">
                <label for="custom-success-value">Expected value</label>
                <input type="text" id="custom-success-value" placeholder="e.g. 0" />
              </div>
            </div>

            <div class="form-group">
              <label>Fields to extract from response</label>
              <div id="custom-fields-list"></div>
              <button type="button" id="custom-add-field-btn" class="btn btn-sm">+ Add field</button>
            </div>

            <div class="curl-box">
              <button type="button" id="custom-test-btn" class="btn btn-sm">Test Connection</button>
              <div id="custom-test-result"></div>
            </div>
          </div>

          <!-- Push notification thresholds -->
          <div id="notify-thresholds-section" style="display: none;">
            <hr class="modal-divider" />
            <div class="form-group">
              <label>Push notification thresholds</label>
              <p class="msg-hint">Notify this device when usage crosses these percentages. Leave a field blank to skip that one.</p>
            </div>
            <div class="form-row">
              <div class="form-group" id="notify-session-group" style="display: none;">
                <label for="notify-session-threshold">Session %</label>
                <input type="number" id="notify-session-threshold" min="1" max="100" placeholder="e.g. 80" />
              </div>
              <div class="form-group" id="notify-weekly-group" style="display: none;">
                <label for="notify-weekly-threshold">Weekly %</label>
                <input type="number" id="notify-weekly-threshold" min="1" max="100" placeholder="e.g. 90" />
              </div>
              <div class="form-group" id="notify-monthly-group" style="display: none;">
                <label for="notify-monthly-threshold">Monthly %</label>
                <input type="number" id="notify-monthly-threshold" min="1" max="100" placeholder="e.g. 90" />
              </div>
            </div>
          </div>

          <div id="modal-error" class="auth-error" style="display: none; margin-top: 12px;"></div>

          <div class="modal-footer">
            <button type="button" id="modal-cancel-btn" class="btn btn-secondary">Cancel</button>
            <button type="submit" id="modal-save-btn" class="btn btn-primary">Save Service</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- From Template Modal -->
  <div id="template-modal" class="modal-backdrop" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3>Choose a Template</h3>
        <button id="template-modal-close-btn" class="icon-btn-close">&times;</button>
      </div>
      <div class="modal-body">
        <input type="text" id="template-search" class="form-select" placeholder="Search templates..." autocomplete="off" />
        <div id="template-categories"></div>
        <p id="template-empty" class="msg-hint" style="display: none;">No templates match your search.</p>
      </div>
    </div>
  </div>

  <!-- Two-factor: step 1 (password) / step 2 (QR + confirm code) -->
  <div id="twofactor-setup-modal" class="modal-backdrop" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3>Enable two-factor authentication</h3>
        <button type="button" id="twofactor-setup-close-btn" class="icon-btn-close">&times;</button>
      </div>
      <div class="modal-body">
        <div id="twofactor-setup-error" class="auth-error" style="display: none;"></div>

        <form id="twofactor-password-form" class="twofactor-step">
          <p class="msg-hint">Confirm your password to continue.</p>
          <div class="form-group">
            <label for="twofactor-setup-password">Password</label>
            <input type="password" id="twofactor-setup-password" autocomplete="current-password" required />
          </div>
          <div class="modal-footer">
            <button type="button" id="twofactor-setup-cancel-btn" class="btn btn-secondary">Cancel</button>
            <button type="submit" class="btn btn-primary">Continue</button>
          </div>
        </form>

        <form id="twofactor-confirm-form" class="twofactor-step" style="display: none;">
          <p class="msg-hint">Scan this QR code with your authenticator app, or enter the code manually.</p>
          <div class="twofactor-qr">
            <img id="twofactor-qr-image" alt="Two-factor QR code" />
          </div>
          <p class="twofactor-secret" id="twofactor-secret-text"></p>
          <div class="form-group">
            <label for="twofactor-confirm-code">6-digit code</label>
            <input type="text" id="twofactor-confirm-code" placeholder="123456" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" required />
          </div>
          <div class="modal-footer">
            <button type="button" id="twofactor-confirm-cancel-btn" class="btn btn-secondary">Cancel</button>
            <button type="submit" class="btn btn-primary">Enable</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Two-factor: recovery codes (shown once after enabling or regenerating) -->
  <div id="twofactor-recovery-modal" class="modal-backdrop" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3>Save your recovery codes</h3>
      </div>
      <div class="modal-body">
        <p class="msg-hint">Each code can be used once to sign in if you lose access to your authenticator app. Store them somewhere safe - they won't be shown again.</p>
        <div id="twofactor-recovery-codes" class="recovery-codes-list"></div>
        <div class="modal-footer">
          <button type="button" id="twofactor-recovery-download-btn" class="btn btn-secondary">Download codes</button>
          <button type="button" id="twofactor-recovery-done-btn" class="btn btn-primary">I've saved these codes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Two-factor: re-auth for disable / regenerate-codes -->
  <div id="twofactor-manage-modal" class="modal-backdrop" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3 id="twofactor-manage-title">Disable two-factor authentication</h3>
        <button type="button" id="twofactor-manage-close-btn" class="icon-btn-close">&times;</button>
      </div>
      <div class="modal-body">
        <div id="twofactor-manage-error" class="auth-error" style="display: none;"></div>
        <form id="twofactor-manage-form">
          <div class="form-group">
            <label for="twofactor-manage-password">Password</label>
            <input type="password" id="twofactor-manage-password" autocomplete="current-password" required />
          </div>
          <div class="form-group">
            <label for="twofactor-manage-code">Two-factor or recovery code</label>
            <input type="text" id="twofactor-manage-code" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" required />
          </div>
          <div class="modal-footer">
            <button type="button" id="twofactor-manage-cancel-btn" class="btn btn-secondary">Cancel</button>
            <button type="submit" id="twofactor-manage-submit-btn" class="btn btn-primary btn-danger">Confirm</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <style>
    .settings-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }
    .settings-header h1 {
      font-size: 24px;
      font-weight: 700;
      margin: 0 0 4px;
    }
    .subtitle {
      color: var(--text-muted);
      font-size: 14px;
      margin: 0;
    }
    .section-divider {
      border: none;
      border-top: 1px solid var(--border);
      margin: 32px 0;
    }
    .categories-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
    }
    :global(.category-row) {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
    }
    :global(.category-row input) {
      flex: 1;
      min-width: 0;
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 14px;
      font-weight: 600;
      padding: 4px 0;
      outline: none;
      font-family: inherit;
    }
    :global(.category-row .cat-actions) {
      display: flex;
      gap: 4px;
      flex-shrink: 0;
    }
    :global(.category-row .icon-btn-sm) {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-muted);
      border-radius: 7px;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 13px;
      line-height: 1;
    }
    :global(.category-row .icon-btn-sm:hover) {
      color: var(--text);
      border-color: var(--text-dim);
    }
    :global(.category-row .icon-btn-sm:disabled) {
      opacity: 0.35;
      cursor: default;
    }
    :global(.category-row .icon-btn-sm.cat-delete:hover) {
      color: var(--red);
      border-color: var(--red);
    }
    .add-category-form {
      display: flex;
      gap: 8px;
    }
    .add-category-form input {
      flex: 1;
      min-width: 0;
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: 14px;
      outline: none;
      font-family: inherit;
    }
    .add-category-form input:focus {
      border-color: var(--gemini);
    }
    :global(.svc-category-badge) {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 2px 9px;
      margin-left: 8px;
    }
    .services-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    :global(.service-card) {
      display: flex;
      justify-content: space-between;
      align-items: center;
