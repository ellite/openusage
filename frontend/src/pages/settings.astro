    function getAuthToken() {
      const token = localStorage.getItem('auth_token');
      if (!token) {
        window.location.href = '/login';
        return null;
      }
      return token;
    }

    // ── Account ──
    async function loadAccount() {
      const token = getAuthToken();
      const input = document.getElementById('account-email') as HTMLInputElement;
      if (!token || !input) return;
      try {
        const res = await fetch('/api/auth/me', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) throw new Error('Failed to load account');
        const data = await res.json();
        input.value = data.user.email || '';
      } catch (e) {
        console.error('Failed to load account', e);
      }
    }

    document.getElementById('account-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const input = document.getElementById('account-email') as HTMLInputElement;
      const errorEl = document.getElementById('account-error');
      const successEl = document.getElementById('account-success');
      if (!token || !input) return;
      if (errorEl) errorEl.style.display = 'none';
      if (successEl) successEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/email', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ email: input.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not update email');
        if (successEl) successEl.style.display = 'block';
        const userStr = localStorage.getItem('auth_user');
        if (userStr) {
          const user = JSON.parse(userStr);
          user.email = input.value.trim();
          localStorage.setItem('auth_user', JSON.stringify(user));
        }
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not update email';
          errorEl.style.display = 'block';
        }
      }
    });

    document.getElementById('password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const currentInput = document.getElementById('current-password') as HTMLInputElement;
      const newInput = document.getElementById('new-password') as HTMLInputElement;
      const errorEl = document.getElementById('password-error');
      const successEl = document.getElementById('password-success');
      if (!token || !currentInput || !newInput) return;
      if (errorEl) errorEl.style.display = 'none';
      if (successEl) successEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/password', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ current_password: currentInput.value, new_password: newInput.value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not update password');
        applySession(data);
        currentInput.value = '';
        newInput.value = '';
        if (successEl) successEl.style.display = 'block';
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not update password';
          errorEl.style.display = 'block';
        }
      }
    });

    // ── Two-factor authentication ──
    function applySession(data: { token: string; user: any }) {
      localStorage.setItem('auth_token', data.token);
      localStorage.setItem('auth_user', JSON.stringify(data.user));
    }

    async function loadTwoFactorStatus() {
      const token = getAuthToken();
      if (!token) return;
      const loadingEl = document.getElementById('twofactor-loading');
      const disabledBlock = document.getElementById('twofactor-disabled-block');
      const enabledBlock = document.getElementById('twofactor-enabled-block');
      try {
        const res = await fetch('/api/auth/2fa', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) throw new Error('Failed to load two-factor status');
        const data = await res.json();
        if (loadingEl) loadingEl.style.display = 'none';
        if (data.enabled) {
          if (enabledBlock) enabledBlock.style.display = 'block';
          if (disabledBlock) disabledBlock.style.display = 'none';
          const remainingEl = document.getElementById('twofactor-recovery-remaining');
          if (remainingEl) {
            remainingEl.textContent = `Enabled - ${data.recovery_codes_remaining} recovery code${data.recovery_codes_remaining === 1 ? '' : 's'} remaining.`;
          }
        } else {
          if (enabledBlock) enabledBlock.style.display = 'none';
          if (disabledBlock) disabledBlock.style.display = 'block';
        }
      } catch (e) {
        if (loadingEl) loadingEl.textContent = 'Could not load two-factor status.';
        console.error('Failed to load 2FA status', e);
      }
    }

    let currentRecoveryCodes: string[] = [];

    function openRecoveryCodesModal(codes: string[]) {
      currentRecoveryCodes = codes;
      const list = document.getElementById('twofactor-recovery-codes');
      if (list) list.innerHTML = codes.map(c => `<span>${c}</span>`).join('');
      document.getElementById('twofactor-recovery-modal')?.style.setProperty('display', 'flex');
    }

    document.getElementById('twofactor-recovery-download-btn')?.addEventListener('click', () => {
      const blob = new Blob([currentRecoveryCodes.join('\n') + '\n'], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'openusage-recovery-codes.txt';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    // Setup: step 1 (password) -> step 2 (QR + confirm code)
    const setupModal = document.getElementById('twofactor-setup-modal');
    const passwordStep = document.getElementById('twofactor-password-form');
    const confirmStep = document.getElementById('twofactor-confirm-form');

    function closeSetupModal() {
      setupModal?.style.setProperty('display', 'none');
      (document.getElementById('twofactor-setup-password') as HTMLInputElement).value = '';
      (document.getElementById('twofactor-confirm-code') as HTMLInputElement).value = '';
      if (passwordStep) passwordStep.style.display = 'flex';
      if (confirmStep) confirmStep.style.display = 'none';
      document.getElementById('twofactor-setup-error')?.style.setProperty('display', 'none');
    }

    document.getElementById('twofactor-enable-btn')?.addEventListener('click', () => {
      setupModal?.style.setProperty('display', 'flex');
    });
    document.getElementById('twofactor-setup-close-btn')?.addEventListener('click', closeSetupModal);
    document.getElementById('twofactor-setup-cancel-btn')?.addEventListener('click', closeSetupModal);
    document.getElementById('twofactor-confirm-cancel-btn')?.addEventListener('click', closeSetupModal);

    document.getElementById('twofactor-password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const passwordInput = document.getElementById('twofactor-setup-password') as HTMLInputElement;
      const errorEl = document.getElementById('twofactor-setup-error');
      if (!token || !passwordInput) return;
      if (errorEl) errorEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/2fa/setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ password: passwordInput.value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not start setup');

        (document.getElementById('twofactor-qr-image') as HTMLImageElement).src = data.qr_code;
        const secretEl = document.getElementById('twofactor-secret-text');
        if (secretEl) secretEl.textContent = data.secret;
        if (passwordStep) passwordStep.style.display = 'none';
        if (confirmStep) confirmStep.style.display = 'flex';
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not start setup';
          errorEl.style.display = 'block';
        }
      }
    });

    document.getElementById('twofactor-confirm-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const codeInput = document.getElementById('twofactor-confirm-code') as HTMLInputElement;
      const errorEl = document.getElementById('twofactor-setup-error');
      if (!token || !codeInput) return;
      if (errorEl) errorEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/2fa/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ code: codeInput.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not confirm code');

        applySession(data);
        closeSetupModal();
        openRecoveryCodesModal(data.recovery_codes);
        await loadTwoFactorStatus();
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not confirm code';
          errorEl.style.display = 'block';
        }
      }
    });

    document.getElementById('twofactor-recovery-done-btn')?.addEventListener('click', () => {
      document.getElementById('twofactor-recovery-modal')?.style.setProperty('display', 'none');
    });

    // Manage (disable / regenerate recovery codes): shared password+code re-auth modal
    let pendingManageAction: 'disable' | 'regenerate' | null = null;
    const manageModal = document.getElementById('twofactor-manage-modal');

    function closeManageModal() {
      manageModal?.style.setProperty('display', 'none');
      (document.getElementById('twofactor-manage-password') as HTMLInputElement).value = '';
      (document.getElementById('twofactor-manage-code') as HTMLInputElement).value = '';
      document.getElementById('twofactor-manage-error')?.style.setProperty('display', 'none');
      pendingManageAction = null;
    }

    document.getElementById('twofactor-disable-btn')?.addEventListener('click', () => {
      pendingManageAction = 'disable';
      const title = document.getElementById('twofactor-manage-title');
      if (title) title.textContent = 'Disable two-factor authentication';
      manageModal?.style.setProperty('display', 'flex');
    });
    document.getElementById('twofactor-regen-btn')?.addEventListener('click', () => {
      pendingManageAction = 'regenerate';
      const title = document.getElementById('twofactor-manage-title');
      if (title) title.textContent = 'Regenerate recovery codes';
      manageModal?.style.setProperty('display', 'flex');
    });
    document.getElementById('twofactor-manage-close-btn')?.addEventListener('click', closeManageModal);
    document.getElementById('twofactor-manage-cancel-btn')?.addEventListener('click', closeManageModal);

    document.getElementById('twofactor-manage-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const passwordInput = document.getElementById('twofactor-manage-password') as HTMLInputElement;
      const codeInput = document.getElementById('twofactor-manage-code') as HTMLInputElement;
      const errorEl = document.getElementById('twofactor-manage-error');
      if (!token || !passwordInput || !codeInput || !pendingManageAction) return;
      if (errorEl) errorEl.style.display = 'none';

      const endpoint = pendingManageAction === 'disable' ? '/api/auth/2fa/disable' : '/api/auth/2fa/recovery-codes';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ password: passwordInput.value, code: codeInput.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not complete request');

        const action = pendingManageAction;
        closeManageModal();
        if (action === 'disable') {
          applySession(data);
          await loadTwoFactorStatus();
        } else {
          openRecoveryCodesModal(data.recovery_codes);
          await loadTwoFactorStatus();
        }
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not complete request';
          errorEl.style.display = 'block';
        }
      }
    });

    async function loadCategories() {
      const listEl = document.getElementById('categories-list');
      const select = document.getElementById('service-category') as HTMLSelectElement;
      const token = getAuthToken();
      if (!listEl || !token) return;

      try {
        const res = await fetch('/api/categories', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error(`HTTP error ${res.status}`);
        allCategories = await res.json();

        listEl.innerHTML = allCategories.map((cat, idx) => `
          <div class="category-row" data-id="${cat.id}">
            <input type="text" class="cat-name-input" value="${escapeHtml(cat.name)}" data-id="${cat.id}" />
            <div class="cat-actions">
              <button type="button" class="icon-btn-sm cat-move-up" data-id="${cat.id}" title="Move up" ${idx === 0 ? 'disabled' : ''}>&uarr;</button>
              <button type="button" class="icon-btn-sm cat-move-down" data-id="${cat.id}" title="Move down" ${idx === allCategories.length - 1 ? 'disabled' : ''}>&darr;</button>
              <button type="button" class="icon-btn-sm cat-delete" data-id="${cat.id}" title="Delete category">&times;</button>
            </div>
          </div>
        `).join('');

        if (select) {
          const current = select.value;
          select.innerHTML = '<option value="">Uncategorized</option>' +
            allCategories.map(cat => `<option value="${cat.id}">${escapeHtml(cat.name)}</option>`).join('');
          select.value = current;
        }

        listEl.querySelectorAll('.cat-name-input').forEach((el: any) => {
          const saveRename = async () => {
            const id = parseInt(el.dataset.id);
            const name = el.value.trim();
            const cat = allCategories.find(c => c.id === id);
            if (!name || !cat || name === cat.name) { el.value = cat?.name ?? ''; return; }
            await fetch(`/api/categories/${id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
              body: JSON.stringify({ name })
            });
            await loadCategories();
          };
          el.addEventListener('blur', saveRename);
          el.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Enter') { e.preventDefault(); el.blur(); }
          });
        });

        listEl.querySelectorAll('.cat-move-up, .cat-move-down').forEach((btn: any) => {
          btn.addEventListener('click', async () => {
            const id = parseInt(btn.dataset.id);
            const direction = btn.classList.contains('cat-move-up') ? 'up' : 'down';
            await fetch(`/api/categories/${id}/move`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
              body: JSON.stringify({ direction })
            });
            await loadCategories();
          });
        });

        listEl.querySelectorAll('.cat-delete').forEach((btn: any) => {
          btn.addEventListener('click', async () => {
            const id = parseInt(btn.dataset.id);
            const cat = allCategories.find(c => c.id === id);
            if (!confirm(`Delete category "${cat?.name}"? Services in it become Uncategorized.`)) return;
            await fetch(`/api/categories/${id}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` }
            });
            await loadCategories();
            await loadUserServices();
          });
        });
      } catch (e) {
        console.error('Failed to load categories', e);
      }
    }

    document.getElementById('add-category-form')?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      const input = document.getElementById('new-category-name') as HTMLInputElement;
      const name = input.value.trim();
      if (!name) return;
      const token = getAuthToken();
      if (!token) return;
      await fetch('/api/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ name })
      });
      input.value = '';
      await loadCategories();
    });

    async function loadUserServices() {
      const listEl = document.getElementById('services-list');
      const headerEl = document.getElementById('settings-header');
      if (!listEl) return;

      const token = getAuthToken();
      if (!token) return;

      try {
        const res = await fetch('/api/user-services', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.status === 401) {
          localStorage.removeItem('auth_token');
          localStorage.removeItem('auth_user');
          window.location.href = '/login';
          return;
        }
        if (!res.ok) {
          throw new Error(`HTTP error ${res.status}`);
        }
        userServices = await res.json();

        if (headerEl) headerEl.style.display = 'flex';

        if (!userServices.length) {
          listEl.innerHTML = '';
          return;
        }

        function iconSrc(svc: any): string {
          const customUrl = svc.config?.generic_icon_url;
          if (svc.service_type === 'custom' && customUrl && /^https?:\/\//i.test(customUrl)) {
            return customUrl;
          }
          return SERVICE_TEMPLATE_MAP[svc.service_type]?.icon || '/favicon.svg';
        }

        listEl.innerHTML = userServices.map(svc => {
          const cat = allCategories.find(c => c.id === svc.category_id);
          return `
          <div class="service-card" data-id="${svc.id}">
            <div class="service-meta">
              <span class="svc-icon ${svc.service_type}-bg">
                <img src="${escapeHtml(iconSrc(svc))}" alt="" width="20" height="20" onerror="this.onerror=null;this.src='/icons/custom.svg';" />
              </span>
              <div class="svc-details">
                <h3>${svc.name}</h3>
                <span class="svc-type-badge">${svc.service_type}</span>
                ${cat ? `<span class="svc-category-badge">${escapeHtml(cat.name)}</span>` : ''}
              </div>
            </div>
            <div class="svc-actions">
              <button class="btn btn-sm btn-edit" data-id="${svc.id}">Edit</button>
              <button class="btn btn-sm btn-danger btn-delete" data-id="${svc.id}">Delete</button>
            </div>
          </div>
        `;
        }).join('');

        // Attach listeners
        document.querySelectorAll('.btn-edit').forEach(btn => {
          btn.addEventListener('click', (e: any) => {
            const id = parseInt(e.target.dataset.id);
            const svc = userServices.find(s => s.id === id);
            if (svc) openModal(svc);
          });
        });

        document.querySelectorAll('.btn-delete').forEach(btn => {
          btn.addEventListener('click', async (e: any) => {
            const id = parseInt(e.target.dataset.id);
            if (confirm('Are you sure you want to remove this service?')) {
              await deleteService(id);
            }
          });
        });

      } catch (err) {
        listEl.innerHTML = `<div class="empty-card"><p class="subtitle" style="color: var(--red);">Failed to load services</p></div>`;
      }
    }

    async function deleteService(id: number) {
      const token = getAuthToken();
      if (!token) return;
      try {
        await fetch(`/api/user-services/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        await loadUserServices();
      } catch (e) {
        alert('Failed to delete service');
      }
    }

    const modal = document.getElementById('service-modal');
    const serviceTypeSelect = document.getElementById('service-type') as HTMLSelectElement;

    // Which of session/weekly/monthly thresholds apply to each service type.
    // Must be kept in sync with backend/thresholds.py's APPLICABLE_THRESHOLDS.
    const APPLICABLE_THRESHOLDS: Record<string, string[]> = {
      claude: ['session', 'weekly'],
      gemini: ['session', 'weekly'],
      chatgpt: ['session', 'weekly'],
      copilot: ['monthly'],
      ollama_cloud: ['session'],
      deepseek: [],
      openai: [],
      custom: [],
    };

    function updateNotifyThresholdsSection() {
      const type = serviceTypeSelect.value;
      const applicable = APPLICABLE_THRESHOLDS[type] || [];
      const section = document.getElementById('notify-thresholds-section');
      if (section) section.style.display = applicable.length ? 'block' : 'none';
      (['session', 'weekly', 'monthly'] as const).forEach((kind) => {
        const group = document.getElementById(`notify-${kind}-group`);
        if (group) group.style.display = applicable.includes(kind) ? 'block' : 'none';
      });
    }

    // Set when a Custom API preset (e.g. 2Captcha) is applied, so the
    // provider-picker row shows the preset's own icon/name instead of the
    // generic "Custom API" one. Cleared whenever the type changes again.
    let activePresetDisplay: { name: string; icon: string } | null = null;

    function updateProviderPickerDisplay() {
      const type = serviceTypeSelect.value;
      const tmpl = activePresetDisplay || SERVICE_TEMPLATE_MAP[type];
      const iconEl = document.getElementById('provider-picker-icon');
      const imgEl = document.getElementById('provider-picker-img') as HTMLImageElement;
      const nameEl = document.getElementById('provider-picker-name');
      if (iconEl) iconEl.className = `svc-icon ${activePresetDisplay ? 'custom' : type}-bg`;
      if (imgEl) imgEl.src = tmpl?.icon || '/icons/custom.svg';
      if (nameEl) nameEl.textContent = tmpl?.name || type;
      const fromTemplateBtn = document.getElementById('from-template-btn') as HTMLButtonElement;
      if (fromTemplateBtn) fromTemplateBtn.style.display = serviceTypeSelect.disabled ? 'none' : '';
    }

    function updateConfigSection() {
      const type = serviceTypeSelect.value;
      document.querySelectorAll('.config-section').forEach((el: any) => el.style.display = 'none');
      const target = document.getElementById(`config-${type}`);
      if (target) target.style.display = 'block';
      updateNotifyThresholdsSection();
      updateProviderPickerDisplay();

      const nameInput = document.getElementById('service-name') as HTMLInputElement;
      const editId = (document.getElementById('edit-service-id') as HTMLInputElement).value;
      if (!editId && nameInput) {
        nameInput.value = SERVICE_TEMPLATE_MAP[type]?.defaultName || 'My Service';
      }
    }

    serviceTypeSelect?.addEventListener('change', updateConfigSection);

    const templateModal = document.getElementById('template-modal');

    function applyCustomPreset(preset: CustomApiPreset) {
      if (!serviceTypeSelect) return;
      activePresetDisplay = { name: preset.name, icon: preset.icon };
      serviceTypeSelect.value = 'custom';
      updateConfigSection();

      (document.getElementById('custom-icon-url') as HTMLInputElement).value = preset.icon;
      (document.getElementById('custom-url') as HTMLInputElement).value = preset.url;
      (document.getElementById('custom-method') as HTMLSelectElement).value = preset.method || 'POST';
      (document.getElementById('custom-body') as HTMLTextAreaElement).value = preset.body || '';
      (document.getElementById('custom-headers') as HTMLTextAreaElement).value = preset.headers || '';

      const fieldsList = document.getElementById('custom-fields-list');
      if (fieldsList) fieldsList.innerHTML = '';
      if (preset.fields.length) {
        preset.fields.forEach(f => addCustomFieldRow(f.label, f.path, f.type, f.symbol || '', f.totalPath || ''));
      } else {
        addCustomFieldRow();
      }

      const nameInput = document.getElementById('service-name') as HTMLInputElement;
      const editId = (document.getElementById('edit-service-id') as HTMLInputElement).value;
      if (!editId && nameInput) nameInput.value = preset.name;
    }

    function templateTileHtml(id: string, name: string, iconHtml: string): string {
      return `
        <button type="button" class="template-tile" data-id="${id}" data-search="${escapeHtml(name.toLowerCase())}">
          ${iconHtml}
          <span>${escapeHtml(name)}</span>
        </button>
      `;
    }

    function renderTemplateGrid() {
      const container = document.getElementById('template-categories');
      if (!container) return;

      const providerCategory = `
        <div class="template-category" data-category="providers">
          <div class="template-section-label">Providers</div>
          <div class="template-grid">
            ${SERVICE_TEMPLATES.map(t => templateTileHtml(
              t.id,
              t.name,
              `<span class="svc-icon ${t.id}-bg"><img src="${t.icon}" alt="" width="20" height="20" /></span>`
            )).join('')}
          </div>
        </div>
      `;

      const presetCategories = new Map<string, CustomApiPreset[]>();
      CUSTOM_API_PRESETS.forEach(p => {
        if (!presetCategories.has(p.category)) presetCategories.set(p.category, []);
        presetCategories.get(p.category)!.push(p);
      });
      const presetCategoriesHtml = Array.from(presetCategories.entries()).map(([category, presets]) => `
        <div class="template-category" data-category="${escapeHtml(category.toLowerCase())}">
          <div class="template-section-label">${escapeHtml(category)}</div>
          <div class="template-grid">
            ${presets.map(p => templateTileHtml(
              p.id,
              p.name,
              `<span class="svc-icon custom-bg"><img src="${escapeHtml(p.icon)}" alt="" width="20" height="20" onerror="this.onerror=null;this.src='/icons/custom.svg';" /></span>`
            )).join('')}
          </div>
        </div>
      `).join('');

      container.innerHTML = providerCategory + presetCategoriesHtml;

      const presetIds = new Set(CUSTOM_API_PRESETS.map(p => p.id));
      container.querySelectorAll('.template-tile').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id;
          if (presetIds.has(id)) {
            const preset = CUSTOM_API_PRESETS.find(p => p.id === id);
            if (preset) applyCustomPreset(preset);
          } else if (id && serviceTypeSelect) {
            activePresetDisplay = null;
            serviceTypeSelect.value = id;
            updateConfigSection();
          }
          closeTemplateModal();
        });
      });

      applyTemplateFilter();
    }

    function applyTemplateFilter() {
      const searchInput = document.getElementById('template-search') as HTMLInputElement;
      const query = (searchInput?.value || '').trim().toLowerCase();
      const emptyMsg = document.getElementById('template-empty');
      let anyVisible = false;

      document.querySelectorAll('#template-categories .template-category').forEach((cat: any) => {
        let categoryHasMatch = false;
        cat.querySelectorAll('.template-tile').forEach((tile: any) => {
          const matches = !query
            || tile.dataset.search.includes(query)
            || (cat.dataset.category || '').includes(query);
          tile.style.display = matches ? '' : 'none';
          if (matches) categoryHasMatch = true;
        });
        cat.style.display = categoryHasMatch ? '' : 'none';
        if (categoryHasMatch) anyVisible = true;
      });

      if (emptyMsg) emptyMsg.style.display = anyVisible ? 'none' : 'block';
    }

    document.getElementById('template-search')?.addEventListener('input', applyTemplateFilter);

    function openTemplateModal() {
      const searchInput = document.getElementById('template-search') as HTMLInputElement;
      if (searchInput) searchInput.value = '';
      renderTemplateGrid();
      if (templateModal) (templateModal as HTMLElement).style.display = 'flex';
      searchInput?.focus();
    }

    function closeTemplateModal() {
      if (templateModal) (templateModal as HTMLElement).style.display = 'none';
    }

    document.getElementById('from-template-btn')?.addEventListener('click', openTemplateModal);
    document.getElementById('template-modal-close-btn')?.addEventListener('click', closeTemplateModal);
    templateModal?.addEventListener('click', (event) => {
      if (event.target === templateModal) closeTemplateModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && (templateModal as HTMLElement)?.style.display !== 'none') closeTemplateModal();
    });

    function resetPasswordToggle(inputId: string, btnId: string) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId) as HTMLInputElement;
      if (!btn || !input) return;
      input.type = 'password';
      const eyeIcon = btn.querySelector('.icon-eye') as HTMLElement;
      const eyeOffIcon = btn.querySelector('.icon-eye-off') as HTMLElement;
      if (eyeIcon) eyeIcon.style.display = 'block';
      if (eyeOffIcon) eyeOffIcon.style.display = 'none';
      btn.title = 'Show API key';
    }

    function wirePasswordToggle(inputId: string, btnId: string) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId) as HTMLInputElement;
      if (!btn || !input) return;
      const eyeIcon = btn.querySelector('.icon-eye') as HTMLElement;
      const eyeOffIcon = btn.querySelector('.icon-eye-off') as HTMLElement;
      btn.addEventListener('click', () => {
        const isPw = input.type === 'password';
        input.type = isPw ? 'text' : 'password';
        if (eyeIcon) eyeIcon.style.display = isPw ? 'none' : 'block';
        if (eyeOffIcon) eyeOffIcon.style.display = isPw ? 'block' : 'none';
        btn.title = isPw ? 'Hide API key' : 'Show API key';
      });
    }
    wirePasswordToggle('custom-api-key', 'custom-api-key-toggle-btn');

    function openModal(svc: any = null) {
      const modalTitle = document.getElementById('modal-title');
      const editIdInput = document.getElementById('edit-service-id') as HTMLInputElement;
      const nameInput = document.getElementById('service-name') as HTMLInputElement;
      const errEl = document.getElementById('modal-error');
      if (errEl) errEl.style.display = 'none';
      customResponseFields = [];
      activePresetDisplay = null;

      if (svc) {
        if (modalTitle) modalTitle.textContent = 'Edit Service';
        if (editIdInput) editIdInput.value = svc.id.toString();
        if (serviceTypeSelect) {
          serviceTypeSelect.value = svc.service_type;
          serviceTypeSelect.disabled = true;
        }
        if (nameInput) nameInput.value = svc.name;
        (document.getElementById('service-category') as HTMLSelectElement).value = svc.category_id != null ? String(svc.category_id) : '';

        const cfg = svc.config || {};
        (document.getElementById('claude-org-url') as HTMLInputElement).value = cfg.claude_org_url || '';
        (document.getElementById('claude-cookies') as HTMLInputElement).value = cfg.claude_cookies || '';
        (document.getElementById('gemini-cookies') as HTMLInputElement).value = cfg.gemini_cookies || '';
        (document.getElementById('gemini-at-token') as HTMLInputElement).value = cfg.gemini_at_token || '';
        (document.getElementById('gemini-bl') as HTMLInputElement).value = cfg.gemini_bl || '';
        (document.getElementById('gemini-sid') as HTMLInputElement).value = cfg.gemini_sid || '';
        (document.getElementById('deepseek-key') as HTMLInputElement).value = cfg.deepseek_api_key || '';
        (document.getElementById('copilot-token') as HTMLInputElement).value = cfg.copilot_token || '';
        (document.getElementById('openai-admin-key') as HTMLInputElement).value = cfg.openai_admin_key || '';
        (document.getElementById('openai-session-key') as HTMLInputElement).value = cfg.openai_session_key || '';
        (document.getElementById('openai-org-id') as HTMLInputElement).value = cfg.openai_org_id || '';
        (document.getElementById('chatgpt-cookies') as HTMLInputElement).value = cfg.chatgpt_cookies || '';
        (document.getElementById('ollama_cloud-cookies') as HTMLInputElement).value = cfg.ollama_cookies || '';
        (document.getElementById('custom-icon-url') as HTMLInputElement).value = cfg.generic_icon_url || '';
        (document.getElementById('custom-url') as HTMLInputElement).value = cfg.generic_url || '';
        (document.getElementById('custom-method') as HTMLSelectElement).value = cfg.generic_method || 'POST';
        (document.getElementById('custom-api-key') as HTMLInputElement).value = cfg.generic_api_key || '';
        (document.getElementById('custom-body') as HTMLTextAreaElement).value = cfg.generic_body || '';
        (document.getElementById('custom-headers') as HTMLTextAreaElement).value = cfg.generic_headers || '';
        (document.getElementById('custom-success-path') as HTMLInputElement).value = cfg.generic_success_path || '';
        (document.getElementById('custom-success-value') as HTMLInputElement).value = cfg.generic_success_value || '';

        const fieldsList = document.getElementById('custom-fields-list');
        if (fieldsList) fieldsList.innerHTML = '';
        const existingFields = Array.isArray(cfg.generic_fields) ? cfg.generic_fields : [];
        if (existingFields.length) {
          existingFields.forEach((f: any) => addCustomFieldRow(
            f.label || '',
            f.path || '',
            f.type || 'text',
            f.symbol || '',
            f.total_path || ''
          ));
        } else {
          addCustomFieldRow();
        }

        const notify = svc.notify_thresholds || {};
        (document.getElementById('notify-session-threshold') as HTMLInputElement).value = notify.session_threshold ?? '';
        (document.getElementById('notify-weekly-threshold') as HTMLInputElement).value = notify.weekly_threshold ?? '';
        (document.getElementById('notify-monthly-threshold') as HTMLInputElement).value = notify.monthly_threshold ?? '';
      } else {
        if (modalTitle) modalTitle.textContent = 'Add Service';
        if (editIdInput) editIdInput.value = '';
        if (serviceTypeSelect) {
          serviceTypeSelect.disabled = false;
          serviceTypeSelect.value = 'custom';
        }
        if (nameInput) nameInput.value = '';
        (document.getElementById('service-category') as HTMLSelectElement).value = '';

        document.querySelectorAll('#service-form input[type="text"], #service-form input[type="password"], #service-form textarea').forEach((el: any) => {
          if (el.id !== 'edit-service-id') el.value = '';
        });
        (document.getElementById('custom-method') as HTMLSelectElement).value = 'POST';
