      border-radius: var(--radius-sm);
      padding: 16px;
      margin: 12px 0;
    }
    .twofactor-qr img {
      width: 180px;
      height: 180px;
    }
    .twofactor-secret {
      text-align: center;
      font-family: monospace;
      font-size: 13px;
      color: var(--text-muted);
      word-break: break-all;
      margin: 0 0 16px;
    }
    .recovery-codes-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 14px;
      margin: 12px 0;
      font-family: monospace;
      font-size: 13.5px;
    }
    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 24px;
    }
    .code-badge {
      background: var(--surface);
      padding: 4px 8px;
      border-radius: 4px;
      border: 1px solid var(--border);
      font-family: monospace;
      color: var(--gemini);
    }
    .device-info {
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .device-info p {
      font-size: 13.5px;
      color: var(--text);
      margin: 0;
    }
  </style>

  <script>
    let userServices: any[] = [];
    let allCategories: any[] = [];

    function getAuthToken() {
      const token = localStorage.getItem('auth_token');
      if (!token) {
        window.location.href = '/login';
        return null;
      }
      return token;
    }

    // ── Account ──
    async function loadAccount() {
      const token = getAuthToken();
      const input = document.getElementById('account-email') as HTMLInputElement;
      if (!token || !input) return;
      try {
        const res = await fetch('/api/auth/me', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) throw new Error('Failed to load account');
        const data = await res.json();
        input.value = data.user.email || '';
      } catch (e) {
        console.error('Failed to load account', e);
      }
    }

    document.getElementById('account-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const input = document.getElementById('account-email') as HTMLInputElement;
      const errorEl = document.getElementById('account-error');
      const successEl = document.getElementById('account-success');
      if (!token || !input) return;
      if (errorEl) errorEl.style.display = 'none';
      if (successEl) successEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/email', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ email: input.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not update email');
        if (successEl) successEl.style.display = 'block';
        const userStr = localStorage.getItem('auth_user');
        if (userStr) {
          const user = JSON.parse(userStr);
          user.email = input.value.trim();
          localStorage.setItem('auth_user', JSON.stringify(user));
        }
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not update email';
          errorEl.style.display = 'block';
        }
      }
    });

    document.getElementById('password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const currentInput = document.getElementById('current-password') as HTMLInputElement;
      const newInput = document.getElementById('new-password') as HTMLInputElement;
      const errorEl = document.getElementById('password-error');
      const successEl = document.getElementById('password-success');
      if (!token || !currentInput || !newInput) return;
      if (errorEl) errorEl.style.display = 'none';
      if (successEl) successEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/password', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ current_password: currentInput.value, new_password: newInput.value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not update password');
        applySession(data);
        currentInput.value = '';
        newInput.value = '';
        if (successEl) successEl.style.display = 'block';
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not update password';
          errorEl.style.display = 'block';
        }
      }
    });

    // ── Two-factor authentication ──
    function applySession(data: { token: string; user: any }) {
      localStorage.setItem('auth_token', data.token);
      localStorage.setItem('auth_user', JSON.stringify(data.user));
    }

    async function loadTwoFactorStatus() {
      const token = getAuthToken();
      if (!token) return;
      const loadingEl = document.getElementById('twofactor-loading');
      const disabledBlock = document.getElementById('twofactor-disabled-block');
      const enabledBlock = document.getElementById('twofactor-enabled-block');
      try {
        const res = await fetch('/api/auth/2fa', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) throw new Error('Failed to load two-factor status');
        const data = await res.json();
        if (loadingEl) loadingEl.style.display = 'none';
        if (data.enabled) {
          if (enabledBlock) enabledBlock.style.display = 'block';
          if (disabledBlock) disabledBlock.style.display = 'none';
          const remainingEl = document.getElementById('twofactor-recovery-remaining');
          if (remainingEl) {
            remainingEl.textContent = `Enabled - ${data.recovery_codes_remaining} recovery code${data.recovery_codes_remaining === 1 ? '' : 's'} remaining.`;
          }
        } else {
          if (enabledBlock) enabledBlock.style.display = 'none';
          if (disabledBlock) disabledBlock.style.display = 'block';
        }
      } catch (e) {
        if (loadingEl) loadingEl.textContent = 'Could not load two-factor status.';
        console.error('Failed to load 2FA status', e);
      }
    }

    let currentRecoveryCodes: string[] = [];

    function openRecoveryCodesModal(codes: string[]) {
      currentRecoveryCodes = codes;
      const list = document.getElementById('twofactor-recovery-codes');
      if (list) list.innerHTML = codes.map(c => `<span>${c}</span>`).join('');
      document.getElementById('twofactor-recovery-modal')?.style.setProperty('display', 'flex');
    }

    document.getElementById('twofactor-recovery-download-btn')?.addEventListener('click', () => {
      const blob = new Blob([currentRecoveryCodes.join('\n') + '\n'], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'openusage-recovery-codes.txt';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    // Setup: step 1 (password) -> step 2 (QR + confirm code)
    const setupModal = document.getElementById('twofactor-setup-modal');
    const passwordStep = document.getElementById('twofactor-password-form');
    const confirmStep = document.getElementById('twofactor-confirm-form');

    function closeSetupModal() {
      setupModal?.style.setProperty('display', 'none');
      (document.getElementById('twofactor-setup-password') as HTMLInputElement).value = '';
      (document.getElementById('twofactor-confirm-code') as HTMLInputElement).value = '';
      if (passwordStep) passwordStep.style.display = 'flex';
      if (confirmStep) confirmStep.style.display = 'none';
      document.getElementById('twofactor-setup-error')?.style.setProperty('display', 'none');
    }

    document.getElementById('twofactor-enable-btn')?.addEventListener('click', () => {
      setupModal?.style.setProperty('display', 'flex');
    });
    document.getElementById('twofactor-setup-close-btn')?.addEventListener('click', closeSetupModal);
    document.getElementById('twofactor-setup-cancel-btn')?.addEventListener('click', closeSetupModal);
    document.getElementById('twofactor-confirm-cancel-btn')?.addEventListener('click', closeSetupModal);

    document.getElementById('twofactor-password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const passwordInput = document.getElementById('twofactor-setup-password') as HTMLInputElement;
      const errorEl = document.getElementById('twofactor-setup-error');
      if (!token || !passwordInput) return;
      if (errorEl) errorEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/2fa/setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ password: passwordInput.value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not start setup');

        (document.getElementById('twofactor-qr-image') as HTMLImageElement).src = data.qr_code;
        const secretEl = document.getElementById('twofactor-secret-text');
        if (secretEl) secretEl.textContent = data.secret;
        if (passwordStep) passwordStep.style.display = 'none';
        if (confirmStep) confirmStep.style.display = 'flex';
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not start setup';
          errorEl.style.display = 'block';
        }
      }
    });

    document.getElementById('twofactor-confirm-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const codeInput = document.getElementById('twofactor-confirm-code') as HTMLInputElement;
      const errorEl = document.getElementById('twofactor-setup-error');
      if (!token || !codeInput) return;
      if (errorEl) errorEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/2fa/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ code: codeInput.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not confirm code');

        applySession(data);
        closeSetupModal();
        openRecoveryCodesModal(data.recovery_codes);
        await loadTwoFactorStatus();
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not confirm code';
          errorEl.style.display = 'block';
        }
      }
    });

    document.getElementById('twofactor-recovery-done-btn')?.addEventListener('click', () => {
      document.getElementById('twofactor-recovery-modal')?.style.setProperty('display', 'none');
    });

    // Manage (disable / regenerate recovery codes): shared password+code re-auth modal
    let pendingManageAction: 'disable' | 'regenerate' | null = null;
    const manageModal = document.getElementById('twofactor-manage-modal');

    function closeManageModal() {
      manageModal?.style.setProperty('display', 'none');
      (document.getElementById('twofactor-manage-password') as HTMLInputElement).value = '';
      (document.getElementById('twofactor-manage-code') as HTMLInputElement).value = '';
      document.getElementById('twofactor-manage-error')?.style.setProperty('display', 'none');
      pendingManageAction = null;
    }

    document.getElementById('twofactor-disable-btn')?.addEventListener('click', () => {
      pendingManageAction = 'disable';
      const title = document.getElementById('twofactor-manage-title');
      if (title) title.textContent = 'Disable two-factor authentication';
      manageModal?.style.setProperty('display', 'flex');
    });
    document.getElementById('twofactor-regen-btn')?.addEventListener('click', () => {
      pendingManageAction = 'regenerate';
      const title = document.getElementById('twofactor-manage-title');
      if (title) title.textContent = 'Regenerate recovery codes';
      manageModal?.style.setProperty('display', 'flex');
    });
    document.getElementById('twofactor-manage-close-btn')?.addEventListener('click', closeManageModal);
    document.getElementById('twofactor-manage-cancel-btn')?.addEventListener('click', closeManageModal);

    document.getElementById('twofactor-manage-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = getAuthToken();
      const passwordInput = document.getElementById('twofactor-manage-password') as HTMLInputElement;
      const codeInput = document.getElementById('twofactor-manage-code') as HTMLInputElement;
      const errorEl = document.getElementById('twofactor-manage-error');
      if (!token || !passwordInput || !codeInput || !pendingManageAction) return;
      if (errorEl) errorEl.style.display = 'none';

      const endpoint = pendingManageAction === 'disable' ? '/api/auth/2fa/disable' : '/api/auth/2fa/recovery-codes';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ password: passwordInput.value, code: codeInput.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || 'Could not complete request');

        const action = pendingManageAction;
        closeManageModal();
        if (action === 'disable') {
          applySession(data);
          await loadTwoFactorStatus();
        } else {
          openRecoveryCodesModal(data.recovery_codes);
          await loadTwoFactorStatus();
        }
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Could not complete request';
          errorEl.style.display = 'block';
        }
      }
    });

    async function loadCategories() {
      const listEl = document.getElementById('categories-list');
      const select = document.getElementById('service-category') as HTMLSelectElement;
      const token = getAuthToken();
      if (!listEl || !token) return;

      try {
        const res = await fetch('/api/categories', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error(`HTTP error ${res.status}`);
        allCategories = await res.json();

        listEl.innerHTML = allCategories.map((cat, idx) => `
          <div class="category-row" data-id="${cat.id}">
            <input type="text" class="cat-name-input" value="${escapeHtml(cat.name)}" data-id="${cat.id}" />
            <div class="cat-actions">
              <button type="button" class="icon-btn-sm cat-move-up" data-id="${cat.id}" title="Move up" ${idx === 0 ? 'disabled' : ''}>&uarr;</button>
              <button type="button" class="icon-btn-sm cat-move-down" data-id="${cat.id}" title="Move down" ${idx === allCategories.length - 1 ? 'disabled' : ''}>&darr;</button>
              <button type="button" class="icon-btn-sm cat-delete" data-id="${cat.id}" title="Delete category">&times;</button>
            </div>
          </div>
        `).join('');

        if (select) {
          const current = select.value;
          select.innerHTML = '<option value="">Uncategorized</option>' +
            allCategories.map(cat => `<option value="${cat.id}">${escapeHtml(cat.name)}</option>`).join('');
          select.value = current;
        }

        listEl.querySelectorAll('.cat-name-input').forEach((el: any) => {
          const saveRename = async () => {
            const id = parseInt(el.dataset.id);
            const name = el.value.trim();
            const cat = allCategories.find(c => c.id === id);
            if (!name || !cat || name === cat.name) { el.value = cat?.name ?? ''; return; }
            await fetch(`/api/categories/${id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
              body: JSON.stringify({ name })
            });
            await loadCategories();
          };
          el.addEventListener('blur', saveRename);
          el.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Enter') { e.preventDefault(); el.blur(); }
          });
        });

        listEl.querySelectorAll('.cat-move-up, .cat-move-down').forEach((btn: any) => {
          btn.addEventListener('click', async () => {
            const id = parseInt(btn.dataset.id);
            const direction = btn.classList.contains('cat-move-up') ? 'up' : 'down';
            await fetch(`/api/categories/${id}/move`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
              body: JSON.stringify({ direction })
            });
            await loadCategories();
          });
        });

        listEl.querySelectorAll('.cat-delete').forEach((btn: any) => {
          btn.addEventListener('click', async () => {
            const id = parseInt(btn.dataset.id);
            const cat = allCategories.find(c => c.id === id);
            if (!confirm(`Delete category "${cat?.name}"? Services in it become Uncategorized.`)) return;
            await fetch(`/api/categories/${id}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` }
            });
            await loadCategories();
            await loadUserServices();
          });
        });
      } catch (e) {
        console.error('Failed to load categories', e);
      }
    }

    document.getElementById('add-category-form')?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      const input = document.getElementById('new-category-name') as HTMLInputElement;
      const name = input.value.trim();
      if (!name) return;
      const token = getAuthToken();
      if (!token) return;
      await fetch('/api/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ name })
      });
      input.value = '';
      await loadCategories();
    });

    async function loadUserServices() {
      const listEl = document.getElementById('services-list');
      const headerEl = document.getElementById('settings-header');
      if (!listEl) return;

      const token = getAuthToken();
      if (!token) return;

      try {
        const res = await fetch('/api/user-services', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.status === 401) {
          localStorage.removeItem('auth_token');
          localStorage.removeItem('auth_user');
          window.location.href = '/login';
          return;
        }
        if (!res.ok) {
          throw new Error(`HTTP error ${res.status}`);
        }
        userServices = await res.json();

        if (headerEl) headerEl.style.display = 'flex';

        if (!userServices.length) {
          listEl.innerHTML = '';
          return;
        }

        const iconMap: Record<string, string> = {
          claude: '/icons/claude.svg',
          gemini: '/icons/gemini.svg',
          deepseek: '/icons/deepseek.svg',
          copilot: '/icons/copilot-white.svg',
          openai: '/icons/openai.svg',
          chatgpt: '/icons/chatgpt.svg',
          ollama_cloud: '/icons/ollama.png',
          custom: '/icons/custom.svg',
        };

        function iconSrc(svc: any): string {
          const customUrl = svc.config?.generic_icon_url;
          if (svc.service_type === 'custom' && customUrl && /^https?:\/\//i.test(customUrl)) {
            return customUrl;
          }
          return iconMap[svc.service_type] || '/favicon.svg';
        }

        listEl.innerHTML = userServices.map(svc => {
          const cat = allCategories.find(c => c.id === svc.category_id);
          return `
          <div class="service-card" data-id="${svc.id}">
            <div class="service-meta">
              <span class="svc-icon ${svc.service_type}-bg">
                <img src="${escapeHtml(iconSrc(svc))}" alt="" width="20" height="20" onerror="this.onerror=null;this.src='/icons/custom.svg';" />
              </span>
              <div class="svc-details">
                <h3>${svc.name}</h3>
                <span class="svc-type-badge">${svc.service_type}</span>
                ${cat ? `<span class="svc-category-badge">${escapeHtml(cat.name)}</span>` : ''}
              </div>
            </div>
            <div class="svc-actions">
              <button class="btn btn-sm btn-edit" data-id="${svc.id}">Edit</button>
              <button class="btn btn-sm btn-danger btn-delete" data-id="${svc.id}">Delete</button>
            </div>
          </div>
        `;
        }).join('');

        // Attach listeners
        document.querySelectorAll('.btn-edit').forEach(btn => {
          btn.addEventListener('click', (e: any) => {
            const id = parseInt(e.target.dataset.id);
            const svc = userServices.find(s => s.id === id);
            if (svc) openModal(svc);
          });
        });

        document.querySelectorAll('.btn-delete').forEach(btn => {
          btn.addEventListener('click', async (e: any) => {
            const id = parseInt(e.target.dataset.id);
            if (confirm('Are you sure you want to remove this service?')) {
              await deleteService(id);
            }
          });
        });

      } catch (err) {
        listEl.innerHTML = `<div class="empty-card"><p class="subtitle" style="color: var(--red);">Failed to load services</p></div>`;
      }
    }

