    }
    .msg-hint.error {
      color: var(--red);
    }
    .auth-error {
      background: color-mix(in srgb, var(--red) 15%, var(--surface));
      border: 1px solid var(--red);
      color: var(--red);
      font-size: 13px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      margin: 8px 0 16px;
    }
    .auth-success {
      background: color-mix(in srgb, var(--green) 15%, var(--surface));
      border: 1px solid var(--green);
      color: var(--green);
      font-size: 13px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      margin: 8px 0 16px;
    }
    .twofactor-actions {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }
    .twofactor-step {
      display: flex;
      flex-direction: column;
