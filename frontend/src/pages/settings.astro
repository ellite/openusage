    // Copilot Device Login
    let copilotPollActive = false;
    let copilotPollTimeout: any = null;

    document.getElementById('copilot-start-btn')?.addEventListener('click', async () => {
      const infoBox = document.getElementById('copilot-device-info');
      const urlEl = document.getElementById('copilot-url') as HTMLAnchorElement;
      const codeEl = document.getElementById('copilot-code');
      const statusEl = document.getElementById('copilot-poll-status');
      const startBtn = document.getElementById('copilot-start-btn') as HTMLButtonElement;

      // Stop any running poll loop
      copilotPollActive = false;
      if (copilotPollTimeout) clearTimeout(copilotPollTimeout);

      try {
        if (startBtn) startBtn.disabled = true;
        const r = await fetch('/api/copilot/device/start', { method: 'POST' });
        const data = await r.json();

        if (data.user_code) {
          if (urlEl) { urlEl.href = data.verification_uri; }
          if (codeEl) codeEl.textContent = data.user_code;
          if (infoBox) infoBox.style.display = 'block';
          if (statusEl) {
            statusEl.textContent = 'Waiting for GitHub authorization...';
            statusEl.style.color = 'var(--text-muted)';
          }

          copilotPollActive = true;
          let currentIntervalMs = ((data.interval || 5) + 1.5) * 1000; // Safety buffer to avoid slow_down

          async function doPoll() {
            if (!copilotPollActive) return;

            try {
              const pr = await fetch('/api/copilot/device/poll', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ device_code: data.device_code })
              });
              const pdata = await pr.json();

              if (!copilotPollActive) return;

              if (pdata.status === 'ok' && pdata.token) {
                copilotPollActive = false;
                if (startBtn) startBtn.disabled = false;
                (document.getElementById('copilot-token') as HTMLInputElement).value = pdata.token;
                if (statusEl) {
                  statusEl.textContent = '✓ Authorization successful! Token populated below.';
                  statusEl.style.color = 'var(--green)';
                }
                return;
              }

              if (pdata.status === 'expired' || pdata.status === 'denied' || pdata.status === 'error') {
                copilotPollActive = false;
                if (startBtn) startBtn.disabled = false;
                if (statusEl) {
                  statusEl.textContent = `Authorization ${pdata.status}: ${pdata.error || 'Failed'}`;
                  statusEl.style.color = 'var(--red)';
                }
                return;
              }

              // If GitHub requested slow_down backoff, adjust interval
              if (pdata.interval) {
                currentIntervalMs = (pdata.interval + 1.5) * 1000;
              }

              if (copilotPollActive) {
                copilotPollTimeout = setTimeout(doPoll, currentIntervalMs);
              }
            } catch (err) {
              if (copilotPollActive) {
                copilotPollTimeout = setTimeout(doPoll, currentIntervalMs);
              }
            }
          }

          copilotPollTimeout = setTimeout(doPoll, currentIntervalMs);
        } else {
          if (startBtn) startBtn.disabled = false;
        }
      } catch (e) {
        if (startBtn) startBtn.disabled = false;
        alert('Failed to start GitHub device flow');
      }
    });

    // Save Form
    document.getElementById('service-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = (document.getElementById('edit-service-id') as HTMLInputElement).value;
      const type = serviceTypeSelect.value;
      const name = (document.getElementById('service-name') as HTMLInputElement).value.trim();
      const errEl = document.getElementById('modal-error');
      if (errEl) errEl.style.display = 'none';

      let config: Record<string, any> = {};
      if (type === 'claude') {
        config = {
          claude_org_url: (document.getElementById('claude-org-url') as HTMLInputElement).value.trim(),
          claude_cookies: (document.getElementById('claude-cookies') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'gemini') {
        config = {
          gemini_cookies: (document.getElementById('gemini-cookies') as HTMLInputElement).value.trim(),
          gemini_at_token: (document.getElementById('gemini-at-token') as HTMLInputElement).value.trim(),
          gemini_bl: (document.getElementById('gemini-bl') as HTMLInputElement).value.trim(),
          gemini_sid: (document.getElementById('gemini-sid') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'deepseek') {
        config = {
          deepseek_api_key: (document.getElementById('deepseek-key') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'copilot') {
        config = {
          copilot_token: (document.getElementById('copilot-token') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'openai') {
        config = {
          openai_admin_key: (document.getElementById('openai-admin-key') as HTMLInputElement).value.trim(),
          openai_session_key: (document.getElementById('openai-session-key') as HTMLInputElement).value.trim(),
          openai_org_id: (document.getElementById('openai-org-id') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'chatgpt') {
        config = {
          chatgpt_cookies: (document.getElementById('chatgpt-cookies') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'ollama_cloud') {
        config = {
          ollama_cookies: (document.getElementById('ollama_cloud-cookies') as HTMLInputElement).value.trim(),
        };
      } else if (type === 'custom') {
        config = collectCustomConfig();
        if (config.generic_fields.some((field: any) => PROGRESS_FIELD_TYPES.has(field.type) && !field.total_path)) {
          if (errEl) {
            errEl.textContent = 'Choose a total field (Y) for each progress ring or bar.';
            errEl.style.display = 'block';
          }
          return;
        }
      }

      const token = getAuthToken();
      if (!token) return;

      const categoryRaw = (document.getElementById('service-category') as HTMLSelectElement).value;
      const category_id = categoryRaw ? parseInt(categoryRaw) : null;

      const applicableThresholds = APPLICABLE_THRESHOLDS[type] || [];
      const readThreshold = (kind: string): number | null => {
        if (!applicableThresholds.includes(kind)) return null;
        const raw = (document.getElementById(`notify-${kind}-threshold`) as HTMLInputElement).value.trim();
        return raw ? Number(raw) : null;
      };
      const notify_thresholds = {
        session_threshold: readThreshold('session'),
        weekly_threshold: readThreshold('weekly'),
        monthly_threshold: readThreshold('monthly'),
      };

      const url = editId ? `/api/user-services/${editId}` : '/api/user-services';
      const method = editId ? 'PUT' : 'POST';
      const body = editId
        ? { name, config, category_id, notify_thresholds }
        : { service_type: type, name, config, category_id, notify_thresholds };

      try {
        const res = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(body)
        });

        if (!res.ok) {
          const d = await res.json();
          throw new Error(d.detail || 'Failed to save service');
        }

        closeModal();
        await loadUserServices();
      } catch (err: any) {
        if (errEl) {
          errEl.textContent = err.message || 'Failed to save service';
          errEl.style.display = 'block';
        }
      }
    });

    // ── Push notifications ──
    function urlBase64ToUint8Array(base64String: string): Uint8Array {
      const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const rawData = atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

    let vapidPublicKey: string | null = null;
    const pushToggleBtn = document.getElementById('push-toggle-btn') as HTMLButtonElement | null;
    const pushTestBtn = document.getElementById('push-test-btn') as HTMLButtonElement | null;
    const pushDescription = document.getElementById('push-description');

    function showPushStatus(message: string, isError: boolean) {
      const el = document.getElementById('push-status');
      if (!el) return;
      el.textContent = message;
      el.style.display = 'block';
      el.className = isError ? 'auth-error' : 'auth-success';
    }

    async function getExistingPushSubscription(): Promise<PushSubscription | null> {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) return null;
      const reg = await navigator.serviceWorker.getRegistration().catch(() => null);
      if (!reg) return null;
      return reg.pushManager.getSubscription();
    }

    async function refreshPushUI() {
      if (!pushToggleBtn) return;
      if (!vapidPublicKey) {
        if (pushDescription) pushDescription.textContent = 'Push notifications are not configured on this server (missing VAPID keys).';
        pushToggleBtn.hidden = true;
        if (pushTestBtn) pushTestBtn.hidden = true;
        return;
      }
      if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
        if (pushDescription) pushDescription.textContent = "This browser doesn't support push notifications.";
        pushToggleBtn.hidden = true;
        if (pushTestBtn) pushTestBtn.hidden = true;
        return;
      }
      pushToggleBtn.hidden = false;
      const sub = await getExistingPushSubscription();
      pushToggleBtn.textContent = sub ? 'Disable on this device' : 'Enable on this device';
      if (pushTestBtn) pushTestBtn.hidden = !sub;
    }

    pushToggleBtn?.addEventListener('click', async () => {
      pushToggleBtn.disabled = true;
      const token = getAuthToken();
      try {
        const existing = await getExistingPushSubscription();
        if (existing) {
          await fetch('/api/push/unsubscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ endpoint: existing.endpoint }),
          });
          await existing.unsubscribe();
          showPushStatus('Disabled on this device.', false);
        } else {
          const permission = await Notification.requestPermission();
          if (permission !== 'granted') {
            throw new Error('Notification permission was not granted');
          }
          const reg = await navigator.serviceWorker.register('/sw.js');
          await navigator.serviceWorker.ready;
          const sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
          });
          const subJson: any = sub.toJSON();
          const res = await fetch('/api/push/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ endpoint: subJson.endpoint, keys: subJson.keys }),
          });
          if (!res.ok) {
            const d = await res.json().catch(() => ({}));
            throw new Error(d.detail || 'Could not save subscription');
          }
          showPushStatus('Enabled on this device.', false);
        }
      } catch (e: any) {
        showPushStatus(e.message, true);
      } finally {
        pushToggleBtn.disabled = false;
        refreshPushUI();
      }
    });

    pushTestBtn?.addEventListener('click', async () => {
      const token = getAuthToken();
      try {
        const res = await fetch('/api/push/test', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) {
          const d = await res.json().catch(() => ({}));
          throw new Error(d.detail || 'Test failed');
        }
        showPushStatus('Test sent — check this device.', false);
      } catch (e: any) {
        showPushStatus(e.message, true);
      }
    });

    async function loadPushConfig() {
      try {
        const res = await fetch('/api/push/public-key');
        const d = await res.json();
        vapidPublicKey = d.public_key;
      } catch {}
      await refreshPushUI();
    }

    loadCategories().then(() => loadUserServices());
    loadAccount();
    loadTwoFactorStatus();
    loadPushConfig();
  </script>
