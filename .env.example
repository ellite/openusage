# Copy this file to .env and fill in what you need. Used both by
# docker-compose.yml (via ${VAR} substitution) and directly by the backend
# when run natively (loaded on startup with python-dotenv).

# Allows new local accounts to be registered. Set to false after creating
# the accounts you need.
ENABLE_ACCOUNT_CREATION=true

# Path to the SQLite database. Defaults to /app/data/openusage.db inside the
# container — usually only needed when running the backend natively.
#DB_PATH=./data/openusage.db

# Used to encrypt two-factor secrets at rest. Set this to a long random
# value in production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Public URL of this instance, used to build password-reset email links.
#SERVER_URL=http://localhost:8000

# --- Password reset emails (optional) ---
# Uncomment and fill in to enable "Forgot password" on the login page.
#SMTP_ADDRESS=smtp.gmail.com
#SMTP_PORT=587
#SMTP_ENCRYPTION=tls
#SMTP_USERNAME=myemail@gmail.com
#SMTP_PASSWORD=<app password>
#FROM_EMAIL=myemail@gmail.com

# --- OIDC / SSO (optional) ---
# Uncomment and fill in to enable "Sign in with SSO" on the login page.
#OIDC_ENABLED=true
#OIDC_PROVIDER_NAME=SSO
#OIDC_CLIENT_ID=your-client-id
#OIDC_CLIENT_SECRET=your-client-secret
#OIDC_AUTH_URL=https://auth.example.com/realms/master/protocol/openid-connect/auth
#OIDC_TOKEN_URL=https://auth.example.com/realms/master/protocol/openid-connect/token
#OIDC_USERINFO_URL=https://auth.example.com/realms/master/protocol/openid-connect/userinfo
#OIDC_REDIRECT_URL=http://localhost:8000/api/oidc/callback
#OIDC_IDENTIFIER_FIELD=email
#OIDC_SCOPES=openid email profile
#OIDC_AUTO_CREATE_USERS=true
#OIDC_DISABLE_PASSWORD_LOGIN=false

# --- Push notifications (optional) ---
# Uncomment and fill in to enable per-service usage-threshold push
# notifications on the Settings page. Generate a key pair with:
# cd backend && python scripts/generate_vapid_keys.py
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com
